// Kick waybar after apt: the custom/updates module rereads
// /var/lib/update-notifier/updates-available on SIGRTMIN+9.
// Named 99zz to come AFTER 99update-notifier in the config: hooks
// run in declaration order, and the file must already be rewritten.
// Copy in ~/.dotfiles/system/. Details: ~/.system-setup/updates-waybar-indicator.md
APT::Update::Post-Invoke-Success {"pkill -RTMIN+9 -x waybar 2>/dev/null || true";};
DPkg::Post-Invoke {"pkill -RTMIN+9 -x waybar 2>/dev/null || true";};
