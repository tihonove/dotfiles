// -*- mode: jsonc -*-
// The bar. A port of the stock /etc/xdg/waybar/config.jsonc — same modules,
// minus only those that have neither a daemon nor a binary on this machine.
{
    "height": 30,
    "spacing": 4,

    // Do NOT set "reload_style_on_change": true. The option does exactly what's
    // needed on a light/dark theme switch — it watches style.css and its
    // @imports, which include the generated colors.css. But it buys nothing: the
    // bar blinks anyway (reload rebuilds the bars), and afterwards the click
    // zones got misaligned — the whole bar acted as one module, a click anywhere
    // toggled the theme. The style is refreshed by `theme-toggle refresh` via SIGUSR2.

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],
    "modules-center": [
        "sway/window"
    ],
    // Order right to left: ⏻, clock, battery, wifi, language, theme, sensors, sound.
    // Clock+battery sit tight together (see paddings in style.css) — one block,
    // "what time is it and how long will the charge last"; cpu/mem/temp is a
    // single module, custom/system, three glyphs in one line.
    //
    // The tray goes first, i.e. left of all the indicators: its contents have
    // arbitrary size and color — apps draw their own icons, the bar's
    // monochrome doesn't apply to them. Inside the sensor row it would push its
    // neighbours apart every time a new icon showed up; at the edge of the
    // group it grows to the left, into empty space, and moves nothing.
    "modules-right": [
        "group/ytm",
        "group/slack",
        "tray",
        "custom/updates",
        "pulseaudio",
        "custom/system",
        "custom/theme",
        "custom/language",
        "network",
        "battery",
        "clock",
        "custom/power"
    ],


    // Dropped from the stock set:
    //   mpd                   — no mpd daemon
    //   power-profiles-daemon — no such service, the module would just sit empty
    //   custom/media          — pulls in playerctl and ~/.config/waybar/mediaplayer.py
    //   battery#bat2          — there's only one battery (qcom-battmgr-bat)
    //   keyboard-state        — Caps switches layout (real Caps is Shift+Caps), nothing to show
    //   backlight             — the bar is crowded enough, brightness is on hotkeys

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    // Hidden windows: an icon with a count, hidden while there are none. Click —
    // a wofi list to pick one, see ~/.local/bin/scratchpad. The glyph is Material
    // Design from Nerd Font, U+F05B2; check edits by codepoints, not by eye.
    "sway/scratchpad": {
        "format": "󰖲 {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}",
        "on-click": "$HOME/.local/bin/scratchpad pick"
    },

    // us/ru layout — switched with Caps Lock or Win+Space (see sway config).
    //
    // The native sway/language is gone: it shows the layout of whichever device
    // an event came from, and wtype (content-tab uses it to switch tabs on
    // $mod+Alt+h/l) creates and kills a virtual keyboard with no layouts at all
    // on every run — the indicator went blank on every tab switch until the
    // next Win+Space. The module can't filter by device, neither in 0.15.0 nor
    // in master, so the layout is read by our own ~/.local/bin/lang-status;
    // all the details are there.
    //
    // No interval: the script is resident and prints a line on each sway event.
    "custom/language": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/lang-status"
    },

    // ytm remote (YouTube music in the terminal): ⏮  󰝚 Title  ⏭ . While ytm is
    // playing nothing, all three are empty and waybar hides them. Sits left of
    // the tray — appears and disappears at the edge, moving nothing.
    //
    // Everything is done by ~/.local/bin/ytm-bar, details there. The title is a
    // resident script subscribed to mpv over IPC, no polling. The buttons use
    // interval "once" + signal 10: ytm-bar redraws them itself when music
    // appears/disappears.
    "group/ytm": {
        "orientation": "horizontal",
        "modules": ["custom/ytm-prev", "custom/ytm", "custom/ytm-next"]
    },
    "custom/ytm": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/ytm-bar status",
        "max-length": 40,
        "on-click": "$HOME/.local/bin/ytm-bar toggle",
        "on-click-right": "$HOME/.local/bin/ytm-bar menu",
        // Wheel — volume of the music only (mpv's own volume); the system
        // volume stays with the pulseaudio module.
        "on-scroll-up": "$HOME/.local/bin/ytm-bar vol +5",
        "on-scroll-down": "$HOME/.local/bin/ytm-bar vol -5"
    },
    "custom/ytm-prev": {
        "format": "{}",
        "exec": "$HOME/.local/bin/ytm-bar button prev",
        "interval": "once",
        "signal": 10,
        "tooltip": false,
        "on-click": "$HOME/.local/bin/ytm-bar prev"
    },
    "custom/ytm-next": {
        "format": "{}",
        "exec": "$HOME/.local/bin/ytm-bar button next",
        "interval": "once",
        "signal": 10,
        "tooltip": false,
        "on-click": "$HOME/.local/bin/ytm-bar next"
    },

    "tray": {
        "spacing": 0
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },

    // Slack is the web version installed from Chrome as an app: it has no tray
    // icon, unread messages show up only in the window title. That's what
    // slack-status reads (resident, subscribed to sway window events). Slack
    // not running — the module is empty and hidden. Click — show the Slack
    // window, including from the scratchpad.
    //
    // Two modules: the icon and a red circle with the count. The circle is CSS
    // of its own widget (border-radius); Pango can't draw that in one label.
    // Nothing unread — the circle is empty and waybar hides it.
    "group/slack": {
        "orientation": "horizontal",
        "modules": ["custom/slack", "custom/slack-count"]
    },
    "custom/slack": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/slack-status icon",
        "on-click": "$HOME/.local/bin/slack-status focus"
    },
    "custom/slack-count": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/slack-status count",
        "on-click": "$HOME/.local/bin/slack-status focus"
    },

    // Sensors: three glyphs in a row, without a single space — a load bar, a
    // memory bar, and a solid temperature rectangle that speaks through color.
    // No numbers on the bar at all, every detail is in the tooltip (on hover,
    // like the clock's calendar).
    //
    // Why one custom module and not the native cpu/memory/temperature in a
    // group: each native module is a separate GtkLabel with its own paddings,
    // they can't be packed tight — a seam between labels remains even with
    // zero padding. Plus the temperature would have to be computed outside
    // anyway: the native module has no color grades and ignores states (tested
    // on 0.15.0 — with "states" and "format-<state>" neither the text changes
    // nor a class gets set; they're not in waybar-temperature(5) either, unlike
    // cpu and memory).
    //
    // Everything is computed by ~/.local/bin/sys-status, thresholds and details there.
    //
    // apt updates: an icon with a count while there's something to install;
    // nothing — the module is hidden. Sits right after the tray by the same
    // logic: it appears and disappears, and at the edge it moves nothing.
    //
    // Checks nothing and polls nothing: reads the file Ubuntu writes after each
    // apt update / dpkg (update-notifier). interval "once" + signal 9 — redraw
    // only on SIGRTMIN+9 from the apt hook /etc/apt/apt.conf.d/99zz-waybar-updates.
    // The lists themselves are fetched by apt-daily.timer, once a day and only on
    // AC power. Details: ~/.system-setup/updates-waybar-indicator.md
    //
    // Click — kitty with apt upgrade; the post-dpkg hook refreshes the icon itself.
    "custom/updates": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/updates-status",
        "on-click": "kitty --single-instance --title 'apt upgrade' bash -c 'sudo apt update && sudo apt upgrade; echo; read -rp \"Enter — закрыть\"'",
        "interval": "once",
        "signal": 9
    },

    // interval 3: the load bar is the difference between two /proc/stat samples,
    // i.e. also the averaging window. Less often — the indicator lies about short
    // spikes; more often — pointless, bash gets forked on every tick.
    "custom/system": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/sys-status",
        "interval": 3
    },

    // The icon is a battery with divisions, 10% step: waybar itself splits 0..100
    // over the array length, so 11 elements give exactly the outline/10/…/90/full scale.
    // The five stock FontAwesome icons are too coarse for that: they had nothing
    // between "full" and "half", while here the charge is readable at a glance.
    //
    // format-icons as an object: waybar looks the key up by status (charging),
    // then by state from states, then default — so charging gets its own row of
    // glyphs (with a bolt) and format-charging doesn't need a separate line.
    //
    // Glyphs are Material Design from Nerd Font: discharging U+F008E, F007A..F0082, F0079;
    // charging U+F089F, F089C, F0086..F0088, F089D, F0089, F089E, F008A, F008B,
    // F0085 (MD numbering isn't contiguous, the order is exactly this — 0,10,…,100).
    // Check edits by codepoints, not by eye: an empty glyph looks like a space
    // and silently breaks the scale.
    // By default — a single icon, no percentage: the 11-glyph scale already
    // shows the charge in 10% steps, and a number next to it just duplicated it.
    // The exact number hasn't gone anywhere — it's in the tooltip and on click
    // (format-alt, together with the time left). The icon turns red below 30% —
    // that's the warning state, colored by style.css.
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-full": "{icon}",
        "format-charging": "{icon}",
        "format-plugged": "{icon}",
        "format-alt": "{icon} {capacity}% {time}",
        "format-icons": {
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
            "default":  ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
        }
    },

    // Compact: a single icon — signal-strength "bars", no SSID or percentage.
    // format-icons goes from weak to strong, waybar itself maps signalStrength
    // 0..100 onto the array length (man 5 waybar-network).
    //
    // The details aren't lost: they're in the tooltip, and a click (format-alt)
    // expands the module to SSID with percentage and back.
    //
    // Icons are Material Design from Nerd Font (U+F091F..U+F092F). There used to
    // be FontAwesome glyphs here, but they ended up empty in the file and the
    // module showed bare text — if you edit these lines, check bytes, not looks.
    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰌘",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "format-alt": "{icon} {essid} {signalStrength}%",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nvia {gwaddr}",
        "tooltip-format-disconnected": "Сеть отключена"
    },

    // The sound server here is pulseaudio (not pipewire), the module listens to it.
    // on-click from the stock config is dropped: pavucontrol isn't installed.
    //
    // {format_source} is removed from all format strings: that's the mic volume,
    // and it sat there as a permanent "100%" next to the speaker volume — two
    // numbers in a row with no hint which is which. The mic isn't adjusted from
    // this bar, nothing to show; what's left is "icon + percent", like the battery.
    //
    // Glyphs are Material Design from Nerd Font: volume low/medium/high U+F057F,
    // F0580, F057E, mute U+F075F, headphones U+F02CB, headset U+F02CD,
    // phone U+F011C, speaker U+F04C3, car U+F010B. The stock config had
    // FontAwesome glyphs here, but they ended up empty in the file — there was no
    // sound icon at all. Check edits by codepoints, not by eye.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰝟 {volume}%",
        "format-muted": "󰝟 {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋍",
            "phone": "󰄜",
            "portable": "󰓃",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },

    // Light/dark theme. The script calls gsettings; from there, via
    // xdg-desktop-portal, the theme reaches Chrome, Electron and GTK — see the
    // comment in ~/.local/bin/theme-toggle.
    //
    // interval "once" + signal: the module doesn't poll, it's redrawn on
    // SIGRTMIN+8 — sent by the script itself, so the icon changes also when the
    // theme is switched from a terminal, not only on click.
    "custom/theme": {
        "format": "{}",
        "return-type": "json",
        "exec": "$HOME/.local/bin/theme-toggle status",
        "on-click": "$HOME/.local/bin/theme-toggle toggle",
        "interval": "once",
        "signal": 8
    },

    // Power menu on click — same as the laptop's power button. The built-in
    // "menu" for custom modules exists only since waybar 0.11, Ubuntu 24.04 ships
    // 0.9.24, where a click did nothing; see ~/.local/bin/power-menu.
    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/power-menu"
    }
}
