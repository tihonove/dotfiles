# vim:ft=swayconfig
# ──────────────────────────────────────────────────────────────────────────────
# Sway. Выбор сессии в GDM: шестерёнка ⚙ → «Sway».
# Перезагрузить конфиг: $mod+Shift+C.
#
# Собирается заново, с нуля. Из старого конфига перенесены только базовые
# настройки и панель; биндов пока намеренно почти нет — добавляем по одному.
# ──────────────────────────────────────────────────────────────────────────────

### Переменные
set $mod Mod4
# --single-instance: все окна обслуживает один процесс kitty. Без него каждое
# окно — независимый инстанс (свой питон, кэши глифов, GPU-контекст + хелпер
# kitten __atexit__), ~110-125 МБ на окно. Разбор: ~/.system-setup/kitty-single-instance-memory.md
set $term /usr/bin/kitty --single-instance
# Chrome нативным Wayland (ozone сам выберет wayland при наличии WAYLAND_DISPLAY).
set $browser google-chrome-stable --ozone-platform-hint=auto
# Лаунчер. В старом конфиге был fuzzel, но его не ставили; взят wofi — умеет
# то же самое. Режим (drun) и оформление живут в ~/.config/wofi/, чтобы голый
# `wofi` из терминала вёл себя как бинд, — отсюда здесь просто имя.
set $menu wofi
set $left h
set $down j
set $up k
set $right l

### Раскладка клавиатуры: US + Russian, переключение Win+Space
input "type:keyboard" {
    xkb_layout us,ru
    xkb_options grp:win_space_toggle
}

### Тачпад: тап-клик и естественная прокрутка
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

### Тема курсора. Без явной темы клиенты грузят "default", где нет resize-курсоров
# (в VSCode/Electron пропадал курсор на границах панелей). Adwaita — полная, уже стоит.
# seat также экспортирует XCURSOR_THEME/XCURSOR_SIZE дочерним клиентам.
seat seat0 xcursor_theme Adwaita 24

### Мониторы
# Панель ноута — eDP-1, внешние выходы — DP-1/DP-2.
#
# Раскладкой заведует kanshi (демон в «Автозапуске» ниже), а не output-блоки
# здесь: sway описывает мониторы поодиночке и про их комбинации не знает, то
# есть «воткнут внешний — погасить eDP-1» в его синтаксисе не выражается.
# Профили — ~/.config/kanshi/config, пишет их $mod+P (см. «Клавиши — запуск»).
#
# Фон — дефолт тёмной темы, как и client.* ниже: на светлой его перекрывает
# `theme-toggle refresh` из «Автозапуска».
output * bg #1e1e2e solid_color

### Внешний вид
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart
gaps inner 8
gaps outer 2
# Имя семейства именно такое: ставится патченый Nerd Font, обычного
# «JetBrains Mono» в системе нет и pango молча подобрал бы что попало.
font pango:JetBrainsMono Nerd Font 10
# Тема Catppuccin Mocha: border | background | text | indicator | child_border
#
# Это ДЕФОЛТ, которым сессия окрашена до того, как отработают exec'и. Если стоит
# светлая тема, ниже `theme-toggle refresh` перекроет эти строки палитрой Latte
# — теми же командами через swaymsg, без reload. Значения совпадают с выводом
# `theme-colors sway dark`; менять цвета надо там, тут — только чтобы стартовый
# кадр не мигал.
client.focused          #89b4fa #1e1e2e #cdd6f4 #b4befe #89b4fa
client.focused_inactive #45475a #1e1e2e #a6adc8 #45475a #45475a
client.unfocused        #313244 #1e1e2e #6c7086 #313244 #313244
client.urgent           #f38ba8 #1e1e2e #1e1e2e #f38ba8 #f38ba8
client.placeholder      #1e1e2e #1e1e2e #cdd6f4 #1e1e2e #1e1e2e
client.background       #1e1e2e

### Правила окон
# bluetuith (TUI-менеджер Bluetooth). Запускается из лаунчера — запись
# ~/.local/share/applications/bluetuith.desktop поднимает его в kitty с
# app_id=bluetuith, отсюда критерий. Всплывает по центру плавающим, а не влезает
# в тайлинг рабочего стола: заглянуть в наушники и закрыть.
# Блочная форма for_window в sway не поддерживается — команды через запятую.
for_window [app_id="bluetuith"] floating enable, resize set 900 600, move position center
# Панель настроек x13s. Тот же приём, что у bluetuith: запись
# x13s-settings.desktop поднимает её в kitty с app_id=x13s-settings, отсюда
# критерий. Плавающей, а не в тайлинге: панель открывают поверх работы, крутят
# ручку и закрывают, раздвигать под неё рабочий стол незачем.
#
# 1000x700 — не на глаз: сайдбар 22 колонки плюс самый широкий экран («Питание»,
# подпись 24 + слайдер + пометка) и ~20 строк содержимого со статус-баром.
for_window [app_id="x13s-settings"] floating enable, resize set 1000 700, move position center
# satty подгоняет окно под размер снимка — в тайлинге от этого нет толку.
for_window [app_id="com.gabm.satty"] floating enable, move position center

# Клик по уведомлению должен открывать приложение. Цепочка: dunst по левой кнопке
# шлёт ActionInvoked обратно отправителю, тот сам показывает нужное место (Slack
# — конкретный тред, а не просто окно) и просит активацию через xdg-activation.
# Дефолт sway на такой запрос — `urgent`: окно лишь подсвечивается в панели, а на
# другом воркспейсе этого не видно вовсе. `focus` заставляет реально переключиться.
#
# Цена: фокус теперь может увести любой клиент, а не только тот, чьё уведомление
# ты нажал. Если начнёт выхватывать посреди набора текста — вернуть `urgent`
# (или `smart`: переключается, только если окно уже на экране) и ходить по
# подсветке биндом $mod+X ниже.
focus_on_window_activation focus

# Прыгнуть на окно, которое просит внимания. Нужен как раз при `urgent`/`smart`,
# но полезен и так — например, если уведомление уже уползло из виду. Более
# точный способ вернуться к уведомлению — $mod+n, см. раздел «Уведомления».
bindsym $mod+x [urgent=latest] focus

### Автозапуск
# Прокинуть переменные сессии в dbus/systemd — нужно панели и порталам.
#
# Тем же заходом поднять демон уведомлений. Полагаться на D-Bus-активацию нельзя:
# сервисы default.target (gdrive-notes-healthcheck) шлют notify-send раньше, чем
# отработает эта строка, активация тогда стартует dunst без WAYLAND_DISPLAY.
# Дропин wayland-only.conf делает такой ранний старт безвредным, но подняться
# демон всё равно должен сам — иначе его не будет до первого уведомления после
# готовности сессии, а Chromium, опросивший шину раньше, до перезапуска рисует
# уведомления своими окнами в тайлинге.
#
# Одной цепочкой, а не соседним exec_always: exec'и sway идут ПАРАЛЛЕЛЬНО, и
# systemctl мог бы обогнать проброс переменных — ровно та гонка, от которой
# лечимся.
# SWAYSOCK в списке не для красоты: swaymsg ищет сокет только в SWAYSOCK/I3SOCK,
# фолбэка по глобу у него нет, а idle-guard гасит экраны именно через swaymsg.
#
# idle-guard — той же цепочкой и по той же причине, что dunst: простой,
# гашение, блокировка и сон (см. ~/.local/bin/idle-guard).
exec_always sh -c 'dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XCURSOR_THEME XCURSOR_SIZE; systemctl --user start dunst.service; exec systemctl --user start idle-guard.service'
# Светлая/тёмная тема + панель, одной цепочкой.
#
# refresh применяет к сессии текущую тему из gsettings: шлёт sway цвета через
# swaymsg (конфиг статичен и знает только тёмные), будит kitty сигналом и
# генерирует colors.css для waybar и wofi.
#
# Почему в одной строке с панелью, а не отдельным exec_always: exec'и sway
# запускаются ПАРАЛЛЕЛЬНО, порядок строк ничего не гарантирует, а waybar без
# colors.css не просто теряет стиль — он падает, `@import` несуществующего файла
# ломает разбор всего style.css. В git этого файла нет (производное состояние),
# на свежей машине его создаёт как раз refresh. Цепочка через ; — единственный
# способ гарантировать, что панель стартует уже с палитрой.
#
# exec_always, а не exec: `exec` отрабатывает только при старте сессии, и после
# $mod+Shift+C ни панель, ни тема бы не вернулись (reload вернул бы тёмные
# client.* из этого файла). pkill перед запуском — чтобы reload не плодил вторую
# копию панели поверх первой.
exec_always sh -c 'pkill -x waybar; $HOME/.local/bin/theme-toggle refresh; exec waybar'
# Стартовать с терминала — заодно страховка, пока биндов почти нет.
exec $term
# Мониторы: применяет профиль под текущий набор выходов и следит за hotplug.
# kanshictl в Ubuntu вырезан (тянет varlink), перечитать конфиг на лету нечем —
# отсюда pkill + перезапуск, он же спасает от второй копии после reload.
#
# Если раскладка уедет и экрана не станет: Ctrl+Alt+F3 (TTY) или ssh, затем
#   pkill -x kanshi && swaymsg output '*' enable
# — и удалить эту строку; без неё всё возвращается к штатному поведению sway.
exec_always sh -c 'pkill -x kanshi; exec kanshi'
# История буфера обмена: два wl-paste --watch, кормящие cliphist. Здесь только
# имя — флаги (лимит истории, типы) лежат в скрипте, рядом с пикером, который их
# и читает. Обёртки `sh -c 'pkill ...'`, как у панели, тут нет намеренно: pkill
# по паттерну нашёл бы этот самый sh по его же командной строке и убил его
# вместо старых вотчеров. Внутри скрипта такой ловушки нет — см. clip-history.
exec_always $HOME/.local/bin/clip-history daemon

### Клавиши — запуск
# Enter «создаёт» на каждом уровне; какой — говорит модификатор, таблица в
# разделе «Вкладки внутри окна».
bindsym --to-code $mod+Return   exec $term
bindsym --to-code $mod+b        exec $browser
bindsym --to-code $mod+d        exec $menu
# Мониторы: GUI-раскладка мышью, по закрытию окна набор запоминается профилем.
bindsym --to-code $mod+p        exec display-setup
bindsym --to-code $mod+Shift+q  kill

### Клавиши — управление sway
bindsym --to-code $mod+Shift+c  reload
bindsym --to-code $mod+Shift+e  exec swaynag -t warning \
    -m 'Выйти из sway? (вернёт на экран входа GDM)' \
    -B 'Выйти' 'swaymsg exit'

### Фокус
bindsym --to-code $mod+$left  focus left
bindsym --to-code $mod+$down  focus down
bindsym --to-code $mod+$up    focus up
bindsym --to-code $mod+$right focus right
bindsym --to-code $mod+Left   focus left
bindsym --to-code $mod+Down   focus down
bindsym --to-code $mod+Up     focus up
bindsym --to-code $mod+Right  focus right

### Перемещение окна
bindsym --to-code $mod+Shift+$left  move left
bindsym --to-code $mod+Shift+$down  move down
bindsym --to-code $mod+Shift+$up    move up
bindsym --to-code $mod+Shift+$right move right
bindsym --to-code $mod+Shift+Left   move left
bindsym --to-code $mod+Shift+Down   move down
bindsym --to-code $mod+Shift+Up     move up
bindsym --to-code $mod+Shift+Right  move right

### Рабочие столы
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9
# Переход между столами: предыдущий / следующий
bindsym --to-code $mod+Ctrl+h workspace prev
bindsym --to-code $mod+Ctrl+l workspace next
# Новый пустой стол — верхняя ступень того же «создать по Enter» (таблица в
# разделе «Вкладки внутри окна»). Своей команды у sway нет: `workspace` ходит по
# номеру, а next/prev — только по существующим столам, «на первый свободный»
# выразить нечем. Номер считает скрипт, см. .local/bin/workspace-new.
bindsym --to-code $mod+Ctrl+Return exec workspace-new

### Вкладки внутри окна: вкладки Chrome, окна tmux (в том числе по ssh)
# Третий уровень навигации, самый внутренний: Ctrl — столы, без модификатора —
# окна и табы sway, Alt — то, что внутри окна. Скрипт не разбирает, кто в
# фокусе: он синтезирует Ctrl+PageUp/PageDown, а это общая комбинация
# переключения вкладок — почему так, расписано в самом content-tab.
bindsym --to-code $mod+Mod1+h exec content-tab prev
bindsym --to-code $mod+Mod1+l exec content-tab next
# Новая вкладка на этом же уровне. Enter «создаёт» на всех трёх уровнях, а какой
# именно — говорит модификатор:
#
#              перейти         создать
#   столы      $mod+Ctrl+h/l   $mod+Ctrl+Enter   (workspace-new, ниже)
#   окна sway  $mod+h/l        $mod+Enter        (терминал, см. «Клавиши — запуск»)
#   вкладки    $mod+Alt+h/l    $mod+Alt+Enter
#
# Вот здесь content-tab всё же смотрит, кто в фокусе, — ровно одной развилкой
# «терминал или нет»: универсальный «новый таб» Ctrl+T в шелле занят виджетом
# fzf по файлам, поэтому в терминал уходит Ctrl+Insert, а его ждёт tmux. Своих
# вкладок kitty не заводит намеренно; разбор — в content-tab.
bindsym --to-code $mod+Mod1+Return exec content-tab new

### Раскладка окон
# Одна клавиша вместо пары splith/splitv: направление следующего сплита
# просто переключается повторным нажатием.
bindsym --to-code $mod+t split toggle
# Отмена сплита: снимает лишний контейнер-обёртку с текущего окна —
# например, когда в сплите осталось одно окно.
bindsym --to-code $mod+Shift+t split none
bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed
bindsym --to-code $mod+e layout toggle split
bindsym --to-code $mod+f fullscreen
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space focus mode_toggle
bindsym --to-code $mod+a focus parent
bindsym --to-code $mod+Shift+a focus child

### Режим изменения размера
mode "resize" {
    bindsym --to-code $left  resize shrink width 30px
    bindsym --to-code $down  resize grow height 30px
    bindsym --to-code $up    resize shrink height 30px
    bindsym --to-code $right resize grow width 30px
    bindsym --to-code Left   resize shrink width 30px
    bindsym --to-code Down   resize grow height 30px
    bindsym --to-code Up     resize shrink height 30px
    bindsym --to-code Right  resize grow width 30px
    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}
bindsym --to-code $mod+r mode "resize"

### Мультимедиа-клавиши
# Громкость через pactl: звуковой сервер тут pulseaudio, а не pipewire, так что
# wpctl из старого конфига (он из wireplumber) не подходит.
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute        exec pactl set-sink-mute   @DEFAULT_SINK@ toggle
# Яркость. --locked: работает и на заблокированном экране.
bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

### Скриншоты
# Вся логика в ~/.local/bin/shot: grim снимает, satty открывает для рисования.
# Enter в satty — скопировать в буфер и закрыть, Ctrl+S — сохранить в
# ~/Pictures/Screenshots, Escape — выкинуть.
bindsym --to-code Print       exec shot        # выделить область мышью
bindsym --to-code Shift+Print exec shot -w     # окно в фокусе
bindsym --to-code $mod+Print  exec shot -f     # весь экран

### История буфера обмена
# $mod+v показывает последние копирования и ВСТАВЛЯЕТ выбранное в текущее окно.
# Вся логика в ~/.local/bin/clip-history: пикер — тот же wofi с тем же
# style.css, что и лаунчер, отличия сведены в ~/.config/wofi/clip-history.conf.
bindsym --to-code $mod+v exec clip-history

### Уведомления
# $mod+n — «нажать» на последнее уведомление с клавиатуры: то же, что ЛКМ по
# плашке (см. dunstrc, раздел «Мышь»), включая переключение фокуса в приложение
# через focus_on_window_activation выше. $mod+Shift+n — список последних, чтобы
# посмотреть, что мигнуло и пропало, и уйти в нужное приложение оттуда.
#
# Почему не голый `dunstctl action 0` в биндах: сработать действием можно только
# по плашке, которая ещё на экране, а нажать хочется как раз по уже пропавшей.
# Обход и разбор — в ~/.local/bin/notify-open.
bindsym --to-code $mod+n       exec notify-open
bindsym --to-code $mod+Shift+n exec notify-open list

### Блокировка экрана
# Через loginctl, а не прямым swaylock: тогда LockedHint у logind честный, и все
# источники блокировки — этот бинд, меню waybar, панель настроек, простой — идут
# одним путём через событие `lock` у swayidle. Демон поднимает idle-guard.
bindsym --to-code Ctrl+Alt+q exec loginctl lock-session

# Не перенесено из старого конфига — нужен пакет, которого не ставили:
#   $mod+Tab MRU-переключение — демон ~/.config/sway/mru-switch.py
