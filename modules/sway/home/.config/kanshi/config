# vim:ft=conf
# ──────────────────────────────────────────────────────────────────────────────
# kanshi — профили мониторов. Демон следит за подключением/отключением выходов и
# применяет профиль, набор выходов которого ТОЧНО совпал с подключёнными.
#
# Блоки ниже пишет `display-setup` (см. ~/.local/bin/display-setup), править
# руками можно, но осторожно: два профиля с одинаковым набором выходов — ошибка
# конфигурации, сработает первый, второй молча не применится никогда.
#
# Встроенная панель адресуется как eDP-1 (имя порта у неё стабильно), внешние
# мониторы — как "производитель модель серийник", чтобы опознавались в любом
# порту. Точные строки: swaymsg -t get_outputs.
#
# Если ни один профиль не подошёл, kanshi не делает ничего и выходы остаются
# как их разложил sway — это безопасный исход, а не поломка.
# ──────────────────────────────────────────────────────────────────────────────


profile PHL-346E2C+laptop {
    output "Philips Consumer Electronics Company PHL 346E2C UK02514035160" enable mode 3440x1440@59.973Hz position 1920,0 scale 1
    output "eDP-1" disable
}

profile laptop {
    output "eDP-1" enable mode 1920x1200@59.999Hz position 0,0 scale 1
}
