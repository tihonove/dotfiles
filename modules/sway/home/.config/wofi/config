# Лаунчер. Вызывается из sway по $mod+d.
#
# Режим задан здесь, а не в строке запуска, чтобы голый `wofi` из терминала
# работал так же, как из бинда.

# drun — записи из .desktop-файлов (/usr/share/applications и
# ~/.local/share/applications): человеческие имена, правильный Exec с
# подстановками, флаг Terminal. Альтернатива — show=run, это просто список
# исполняемых из $PATH (1600 штук против ~15 приложений).
show=drun

### Геометрия
# Пиксели, а не проценты: ноут и внешний монитор сильно разной ширины, в
# процентах окно на большом мониторе разъезжается в полэкрана.
width=600
lines=10
location=center

### Поведение
prompt=»
insensitive=true
# fuzzy вместо дефолтного contains: «vsc» находит «Visual Studio Code».
matching=fuzzy
# Терминал для записей с Terminal=true (btop++, Htop, Ncmpcpp, Vim) — без
# него они запустились бы без tty и молча умерли. Аргументы сюда не
# передать, поэтому --single-instance тут нет: TUI-приложения из лаунчера
# поднимают отдельный инстанс kitty. Из бинда $mod+Return всё как было.
term=kitty
hide_scroll=true
gtk_dark=true

### Иконки
# Выключены намеренно: у sway и waybar плоский текстовый вид без иконок,
# лаунчер с картинками из него выпадает. Включить — allow_images=true
# (размер регулируется image_size, дефолт 32).
allow_images=false
