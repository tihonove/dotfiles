[Desktop Entry]
# Пункт для лаунчера (wofi, $mod+D) — чтобы съёмка находилась, даже когда
# забылся бинд. Бинд — в Name: wofi показывает только его. Путь абсолютный —
# PATH лаунчера не то, что PATH в шелле. Вся шестёрка: shot-*.desktop, screenrec*.desktop.
Type=Application
Name=Screen recording — window  (Ctrl+Shift+Print; again — stop)
Comment=Click a window; smooth cursor, zoom, background
Exec=/home/tihonove/.local/bin/screenrec -w
Terminal=false
Categories=AudioVideo;Video;Recorder;
Keywords=screen;record;recorder;video;screencast;запись;экран;видео;демо;скринкаст;window;окно;stop;стоп;
StartupNotify=false
