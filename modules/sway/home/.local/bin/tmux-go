#!/usr/bin/env bash
# Сессия tmux на удалённой машине за одно нажатие ($mod+Shift+Enter).
#
# Руками это три шага: новый терминал, `kitten ssh <машина>`, потом
# `tmux attach` или `tmux new -A -s <имя>` — и перед вторым ещё `tmux ls`,
# чтобы вспомнить, что там живёт. Здесь то же самое одной командой: машина
# выбирается в wofi, а сессия — уже внутри tmux, в его штатном choose-tree:
# дерево «сессии → окна» с живым превью, Enter переключает. Своего пикера
# сессий нет намеренно: choose-tree и так показывает всё, что нужно, и есть на
# любой машине, где есть tmux, — ставить на удалённую сторону ничего не надо.
#
# ── Машина ────────────────────────────────────────────────────────────────────
# Список — блоки `Host` из ~/.ssh/config.d/*.conf, то есть машинно-локальный
# инвентарь (почему хосты живут там, а не в ~/.ssh/config, — в шапке самого
# ~/.ssh/config). Шаблоны вроде `Host *` — не машины, пропускаются. Имя, набранное
# в wofi мимо списка, тоже годится: wofi отдаёт введённый текст, и он уходит
# в ssh как есть.
#
# ── Сессия ────────────────────────────────────────────────────────────────────
# На удалённой стороне: есть сервер tmux — attach к любой сессии и сразу
# choose-tree поверх; нет — новая сессия `main`, выбирать всё равно не из чего.
# Переименовать её потом — prefix $.
#
# Создать новую сессию из самого дерева choose-tree нельзя: его клавиши зашиты
# в tmux и через `bind -T` не переопределяются. Обход — prefix-таблица: prefix
# перехватывается раньше режима, поэтому `prefix N` работает и поверх дерева,
# спрашивает имя и делает `new-session -A` — новую или переход в существующую с
# таким именем. Бинд есть в tmux.conf, но он же передаётся в команде: на
# машине без наших dotfiles (свежий devsy-контейнер) конфига нет, а prefix N
# нужен всё равно. На машине с конфигом бинд просто перезапишется тем же самым.
#
# Почему команда, а не отдельный скрипт на удалённой стороне: скрипт пришлось бы
# доставлять (copy в ssh.conf) и держать актуальным на каждой машине, а тут
# четыре строки шелла, они едут вместе с вызовом. kitten ssh при переданной
# команде всё равно копирует terminfo — теряется только shell integration, а она
# внутри tmux и так не работает.
#
# Всё внутри одного окна kitty: `kitty --single-instance -- <команда>` открывает
# новое окно в уже живущем инстансе (как $mod+Enter) и запускает в нём команду
# вместо шелла; закрылась команда — закрылось окно. Своих вкладок kitty не
# заводит, см. content-tab.

set -euo pipefail

readonly WOFI_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/wofi/tmux-go.conf"

# `Host a b` — несколько имён в одном блоке, каждое в свою строку. Дедупликация
# без сортировки: порядок из файлов осмысленнее алфавитного.
hosts=$(sed -n 's/^[[:space:]]*Host[[:space:]]\+//p' ~/.ssh/config.d/*.conf 2>/dev/null \
    | tr ' ' '\n' | grep -v '[*?!]' | awk '!seen[$0]++' || true)

host=$(printf '%s\n' "$hosts" | wofi --dmenu --conf "$WOFI_CONF") || exit 0
[ -n "$host" ] || exit 0

# Запускается login-шеллом удалённой стороны (`$SHELL -c`, так делает kitten ssh),
# поэтому синтаксис — POSIX sh. Кавычки внутри — как в tmux.conf: tmux разбирает
# свои аргументы сам, одинарные внутри двойных ему понятны.
# -Z — на весь экран, -w — сессии раскрыты до окон, панели свёрнуты.
remote=$(cat <<'REMOTE'
if tmux has-session 2>/dev/null; then
    exec tmux attach-session \; \
        bind N command-prompt -p 'новая сессия:' "new-session -A -s '%%'" \; \
        choose-tree -Zw \; \
        display-message -d 4000 'Enter — перейти, +/- — развернуть, prefix N — новая сессия'
else
    exec tmux new-session -s main
fi
REMOTE
)

# -t: команда передана, сама по себе ssh под неё tty не выделит, а tmux без
# tty не живёт.
exec kitty --single-instance -- kitten ssh -t "$host" "$remote"
