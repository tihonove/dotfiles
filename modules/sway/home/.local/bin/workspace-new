#!/usr/bin/env bash
# Перейти на пустой рабочий стол — верхняя ступень «создать» ($mod+Ctrl+Enter),
# см. sway/config, раздел «Рабочие столы». Уровень задаёт модификатор, действие
# — клавиша:
#
#              перейти         создать
#   столы      $mod+Ctrl+h/l   $mod+Ctrl+Enter   (этот скрипт)
#   окна sway  $mod+h/l        $mod+Enter        (штатные бинды sway)
#   вкладки    $mod+Alt+h/l    $mod+Alt+Enter    (.local/bin/content-tab)
#
# Почему скриптом, а не биндом. Своей команды у sway для этого нет: `workspace`
# ходит на стол по номеру или имени, а `next`/`prev` — только по существующим.
# «На первый свободный» выразить нечем, номер надо посчитать самим — отсюда
# get_workspaces и jq.
#
# Стол создаётся ровно тем же `workspace number N`, что и бинды $mod+1..9, то
# есть на текущем выходе и с обычным номером: если свободен 4 — это будет
# в точности тот стол, куда потом вернёт $mod+4.
#
# Пустых столов в sway не бывает — стол исчезает, как только с него ушло
# последнее окно. Исключение ровно одно: тот, что сейчас в фокусе. Поэтому если
# текущий стол уже пуст, идти некуда и скрипт молча выходит — иначе нажатие
# уводило бы с пустого стола на другой пустой, каждый раз с новым номером.

set -euo pipefail

# Фокус стоит на самом столе, а не на окне, ровно в одном случае — стол пуст.
# (Сфокусированный узел в дереве всегда один, даже когда выходов несколько.)
focused_type=$(swaymsg -t get_tree | jq -r '
    [recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true)][0].type')
if [ "$focused_type" = "workspace" ]; then
    exit 0
fi

# Первый номер, которого нет среди занятых. У именованных столов .num = -1
# (у нас таких нет, но диапазон начинается с 1 и они не мешают в любом случае).
free=$(swaymsg -t get_workspaces | jq '
    [.[].num] as $used
    | first(range(1; 1000) as $n | select($used | index($n) | not) | $n)')

exec swaymsg workspace number "$free"
