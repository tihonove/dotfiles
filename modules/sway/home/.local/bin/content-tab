#!/usr/bin/env bash
# Вкладки ВНУТРИ сфокусированного окна: вкладки Chrome, окна tmux.
#
# Третий, самый внутренний уровень навигации sway (см. sway/config, раздел
# «Вкладки внутри окна»). Уровень задаёт модификатор, действие — клавиша:
#
#              перейти         создать
#   столы      $mod+Ctrl+h/l   $mod+Ctrl+Enter   (.local/bin/workspace-new)
#   окна sway  $mod+h/l        $mod+Enter        (штатные бинды sway)
#   вкладки    $mod+Alt+h/l    $mod+Alt+Enter    (этот скрипт)
#
# ── Переход: content-tab next|prev ────────────────────────────────────────────
#
# Почему тут нет никакого определения приложения. Первым делом хочется спросить
# swaymsg -t get_tree, кто в фокусе, и слать каждому его комбинацию. Не нужно:
# Ctrl+PageUp/PageDown — и есть общая комбинация переключения вкладок. Её
# понимают Chrome, Firefox, VS Code, GTK-приложения. Единственный, кого пришлось
# научить, — tmux, и там это две строки `bind -n` (tmux.conf, «Вкладки
# контента»). Таблица «app_id → своя комбинация» была бы кодом, который надо
# пополнять под каждое новое приложение, ради ровно того же результата.
#
# Почему синтез клавиш, а не команда напрямую. До вкладок Chrome снаружи не
# дотянуться вообще ничем: CLI у него нет. До tmux — казалось бы, можно позвать
# `tmux next-window`, но нечем выбрать нужного клиента: kitty запускается с
# --single-instance, и pid окна из дерева sway один на все окна kitty, так что
# сопоставить окно с tty клиента tmux не выйдет; kitty remote control выключен
# сознательно (см. README, «Сознательно не переносим»). А для tmux на удалённой
# машине под ssh локальной команды не существует в принципе. Синтез же работает
# везде одинаково: kitty пишет в pty escape \e[6;5~, и дальше его читает либо
# локальный tmux, либо ssh увозит байты в удалённый pty к удалённому tmux.
#
# ── Создание: content-tab new ─────────────────────────────────────────────────
#
# А вот здесь одной универсальной комбинации нет, и абзац выше приходится
# нарушить — ровно на одну развилку.
#
# Универсальный «новый таб» — Ctrl+T: его понимают Chrome, Firefox, VS Code,
# GTK. Но в терминале эта клавиша занята: C-t — виджет fzf по файлам (README,
# «fzf»), и забрать её в root-таблицу tmux значило бы сломать то, что работает.
# Поэтому развилка ровно одна и она бинарная — терминал или не терминал; таблицы
# «app_id → своя комбинация» так и не заводится: терминалы перечислены поимённо
# в case ниже, всё остальное скопом получает Ctrl+T.
#
# В терминал уходит Ctrl+Insert — клавиша, которой не пользуется в шелле никто:
# ни readline, ни ble.sh, ни fzf, ни tmux до этой правки. tmux ловит её как
# C-IC (tmux.conf, «Вкладки контента») и делает new-window. Дальше всё как у
# перехода: kitty пишет в pty обычный \e[2;5~, и его читает либо локальный tmux,
# либо удалённый на том конце ssh.
#
# Почему настоящая клавиша, а не собственная escape-последовательность (у tmux
# для этого есть user-keys, и они бы вообще ни с чем не пересеклись): её
# пришлось бы набирать через wtype по байтам — ESC отдельным нажатием, следом
# «[240~». А tmux после ESC ждёт продолжения ровно escape-time (у нас 10 мс) и,
# не дождавшись, считает его самостоятельным Escape. Ctrl+Insert же kitty пишет
# в pty одним куском, и гонки нет вовсе.
#
# Своих вкладок kitty при этом не заводит намеренно: kitty-таб снаружи не виден
# — для sway это по-прежнему одно окно, — дублирует окно tmux и путает счёт
# уровней. Клавиша просто уходит в pty: есть там tmux — будет новое окно, нет —
# не произойдёт ничего.
#
# Ограничение: вложенный tmux (локальный, внутри него ssh и ещё один tmux) не
# поддерживается — клавишу перехватит внешний. См. README, раздел «tmux».
#
# Использование:
#   content-tab next   — следующая вкладка (Ctrl+PageDown)
#   content-tab prev   — предыдущая вкладка (Ctrl+PageUp)
#   content-tab new    — новая вкладка (Ctrl+T, в терминале Ctrl+Insert)

set -euo pipefail

case "${1:-}" in
    # Канонические имена keysym в xkbcommon: Next = Page Down, Prior = Page Up.
    next) exec wtype -M ctrl -k Next  -m ctrl ;;
    prev) exec wtype -M ctrl -k Prior -m ctrl ;;
    new)  ;;  # ниже, ему нужна развилка
    *) echo "Использование: content-tab next|prev|new" >&2; exit 2 ;;
esac

# app_id — у окон Wayland, window_properties.class — у X11 через Xwayland.
# Сфокусированный узел в дереве ровно один; на пустом столе фокус стоит на самом
# столе, тогда [0] даёт его, app_id там нет и обе подстановки дают пустую строку.
app=$(swaymsg -t get_tree | jq -r '
    [recurse(.nodes[]?, .floating_nodes[]?) | select(.focused == true)][0]
    | .app_id // .window_properties.class // ""')

case "$app" in
    # Терминалы: Ctrl+Insert уходит в pty, там его ждёт tmux. Появится ещё один
    # терминал — дописать сюда, это и есть вся «таблица приложений».
    kitty) key=Insert ;;
    # Всё остальное: Ctrl+T, штатный «новый таб» браузеров и GUI-приложений.
    *)     key=t      ;;
esac

exec wtype -M ctrl -k "$key" -m ctrl
