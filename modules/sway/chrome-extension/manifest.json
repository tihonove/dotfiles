{
  "manifest_version": 3,
  "name": "browser-here",
  "version": "1.0",
  "description": "Ссылки из окон приложений Chrome (Slack) — в browser-here, то есть в Chrome на текущем столе sway",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
