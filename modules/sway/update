#!/bin/bash

# Внешние тулзы и машинное состояние модуля sway — то, что симлинком не
# разложишь.
#
# Два пункта: satty (аннотирование скриншотов, в apt его нет) и браузер по
# умолчанию. ~/.config/mimeapps.list в репу не
# положить — в него пишут сами программы (Chrome, Telegram, xdg-settings), и
# симлинк в репу означал бы вечно грязный git status. Поэтому файл остаётся
# машинным, а нужную запись в нём держит этот скрипт.

set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../lib" && pwd)/tools.sh"

# browser-here — обёртка над Chrome (см. ~/.local/bin/browser-here), поэтому
# место она занимает только у Chrome. Стоит по умолчанию другой браузер — это
# чьё-то решение, и молча его отменять незачем.
#
# .desktop пишется отсюда, а не лежит в репе симлинком, из-за Exec: в нём нужен
# АБСОЛЮТНЫЙ путь, а он у каждой машины свой. Голое `browser-here` не годится —
# у сервисов systemd --user (xdg-desktop-portal) ~/.local/bin в PATH нет. Ни ~,
# ни $HOME Exec не раскрывает, а обход через `sh -c '… "$HOME/…"'` понимает gio,
# но не xdg-open: тот режет Exec по пробелам, не глядя на кавычки (проверено —
# «Unterminated quoted string», и ссылка молча не открывается).
#
# Обратного хода нет намеренно. Снимут модуль — пропадёт browser-here, и запись
# отключится сама: по TryExec её отбрасывает GLib, по отсутствию команды —
# xdg-open, и оба идут к следующему, кто заявил http/https, то есть к Chrome.
register_browser_here() {
    echo "Браузер по умолчанию..."

    local ours=browser-here.desktop
    local apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local bin="$BIN_DIR/browser-here"

    if ! have xdg-settings; then
        echo "  xdg-settings нет (пакет xdg-utils) — пропускаю"
        return 0
    fi
    if ! have google-chrome-stable; then
        echo "  Chrome не установлен — оборачивать нечего, пропускаю"
        return 0
    fi
    if [[ ! -x "$bin" ]]; then
        echo "❌ нет $bin — раскладка модуля не прошла?" >&2
        return 1
    fi

    # Пишем, только если содержимое разошлось: скрипт гоняется на каждой
    # установке, и трогать файл без причины незачем.
    local entry
    entry=$(cat <<EOF
[Desktop Entry]
Type=Application
Name=Chrome на текущем столе
Comment=Ссылка — вкладкой в Chrome текущего стола sway, а нет его тут — новым окном
TryExec=$bin
Exec=$bin %U
NoDisplay=true
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
EOF
)
    if [[ ! -f "$apps/$ours" || "$(cat "$apps/$ours")" != "$entry" ]]; then
        mkdir -p "$apps"
        printf '%s\n' "$entry" > "$apps/$ours"
        echo "  записан $apps/$ours"
    fi

    local current
    current=$(xdg-settings get default-web-browser 2>/dev/null || true)

    case "$current" in
        "$ours")
            echo "  ✅ уже $ours"
            ;;
        google-chrome.desktop|"")
            xdg-settings set default-web-browser "$ours"
            echo "  ✅ ${current:-не задан} -> $ours"
            ;;
        *)
            echo "  ⚠  по умолчанию стоит $current, не Chrome — не трогаю."
            echo "     Если нужно: xdg-settings set default-web-browser $ours"
            ;;
    esac
}

# satty — GitHub-релиз, по схеме starship из core/update: системный не трогаем,
# свой в ~/.local/bin сверяем по версии. Ассеты собраны под gnu, не musl (GTK4
# линкуется динамически), поэтому arch_for rust тут не подходит.
#
# Последний релиз не обязательно запускается: с 0.21.0 сборки против glibc 2.43,
# а в Ubuntu 24.04 — 2.39, и бинарник падает с «version GLIBC_2.43 not found».
# Поэтому идём по релизам сверху вниз и ставим первый, у которого работает
# --version. Спуск останавливается на уже стоящей версии: она и есть самая
# свежая из работающих, качать её заново незачем.
install_satty() {
    echo "satty..."

    local path cur tmp v versions
    path="$(command -v satty || true)"
    if [[ -n "$path" && "$path" != "$BIN_DIR/satty" ]]; then
        echo "  ✅ системный: $("$path" --version | head -1) ($path)"
        return 0
    fi

    cur=$("$BIN_DIR/satty" --version 2>/dev/null | grep -oP '[0-9]+(\.[0-9]+)+' | head -1 || true)

    versions=$(curl -fsSL 'https://api.github.com/repos/gabm/satty/releases?per_page=10' \
        | grep -oP '"tag_name":\s*"v?\K[^"]+')
    [[ -n "$versions" ]] || { echo "❌ Не получил список релизов satty" >&2; return 1; }

    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" RETURN

    for v in $versions; do
        if [[ "$v" == "$cur" ]]; then
            echo "  ✅ уже актуален: satty $cur"
            return 0
        fi
        echo "  пробую v$v"
        # В архиве кроме бинарника man, completions и .desktop — нужен только
        # бинарник, запускается он из sway по Print.
        curl -fsSL -o "$tmp/satty.tar.gz" \
            "https://github.com/gabm/satty/releases/download/v${v}/satty-$(uname -m)-unknown-linux-gnu.tar.gz"
        tar -xzf "$tmp/satty.tar.gz" -C "$tmp" ./satty
        if ! "$tmp/satty" --version >/dev/null 2>"$tmp/err"; then
            echo "    не запускается: $(head -1 "$tmp/err")"
            continue
        fi
        mkdir -p "$BIN_DIR"
        install -m 755 "$tmp/satty" "$BIN_DIR/satty"
        echo "  ✅ $("$BIN_DIR/satty" --version | head -1)"
        return 0
    done

    echo "❌ Ни один из последних релизов satty не запускается на этой машине" >&2
    return 1
}

# ytm — YouTube Music в терминале (https://github.com/MaheshBhushan/yt-music-cli),
# под него пульт в waybar (~/.local/bin/ytm-bar). Python-пакет, ставится через
# `uv tool`: в Ubuntu нет python3-venv, а uv — один бинарник без sudo.
#
# --with secretstorage: без него ytm не может импортировать вход из Chrome:
# куки Chrome шифрует ключом из gnome-keyring, а достаёт его yt-dlp через этот
# модуль. Без модуля все куки «не расшифровываются».
#
# Upgrade на каждом прогоне — не прихоть: внутри окружения ytm свой yt-dlp, а
# устаревший yt-dlp YouTube отшивает 403 за пару месяцев. uv tool upgrade
# обновляет и его, а состав (с secretstorage) берёт из uv-receipt.toml.
#
# Вход в аккаунт — руками и один раз, автоматизировать тут нечего:
#   XDG_CURRENT_DESKTOP=GNOME ytm login --from-browser chrome
# Переменная нужна потому, что под sway она пустая, и yt-dlp тогда ищет ключ
# не в gnome-keyring.
install_ytm() {
    echo "ytm..."

    local uv
    uv="$(command -v uv || true)"
    if [[ -z "$uv" ]]; then
        echo "  ставлю uv"
        curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh >/dev/null
        uv="$BIN_DIR/uv"
    fi

    local before after ytdlp
    before=$("$uv" tool list 2>/dev/null | grep -oP '^ytm v\K\S+' || true)
    if [[ -z "$before" ]]; then
        "$uv" tool install --quiet ytm --with secretstorage
        echo "  ✅ $("$uv" tool list | grep '^ytm ')"
    else
        "$uv" tool upgrade --quiet ytm
        after=$("$uv" tool list | grep -oP '^ytm v\K\S+')
        ytdlp=$("$("$uv" tool dir)/ytm/bin/yt-dlp" --version 2>/dev/null || echo '?')
        if [[ "$before" == "$after" ]]; then
            echo "  ✅ уже актуален: ytm $after, yt-dlp $ytdlp"
        else
            echo "  ✅ ytm $before -> $after, yt-dlp $ytdlp"
        fi
    fi
}

# Системные пакеты под музыку. В requires их нет намеренно: без них не работает
# только музыкальная часть, а requires — это «без этого модуль не ставится
# вовсе». sudo dotfiles не зовут, поэтому только подсказка.
#
#   mpv        — ytm играет через него;
#   mpv-mpris  — плагин: mpv становится MPRIS-плеером. Без него не доходят
#                медиаклавиши (playerctl) и пауза, когда снял наушник
#                (AVRCP → mpris-proxy из bluez → MPRIS), а audio-autopause не
#                видит mpv. Команды у плагина нет, поэтому проверка по файлу;
#   socat      — им ytm-bar ходит в IPC-сокет mpv. Без него пульт просто
#                не показывается.
check_media_packages() {
    echo "Пакеты для музыки..."
    local missing=()
    have mpv   || missing+=(mpv)
    [[ -e /etc/mpv/scripts/mpris.so ]] || missing+=(mpv-mpris)
    have socat || missing+=(socat)
    if (( ${#missing[@]} )); then
        echo "  ⚠  нет: ${missing[*]}"
        echo "     sudo apt install ${missing[*]}"
    else
        echo "  ✅ на месте"
    fi
}

# Пакеты под sway-overview (обзор столов по тапу $mod). Это python + GTK3 через
# gi, а в requires проверяются только команды — модуль Python и typelib так не
# проверишь. Без них бинд просто молча ничего не делает, поэтому проверка тут.
# Спрашиваем самого python: он импортирует ровно то, что импортирует скрипт.
check_overview_packages() {
    echo "Пакеты для sway-overview..."
    if python3 - <<'EOF' 2>/dev/null
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, GtkLayerShell
EOF
    then
        echo "  ✅ на месте"
    else
        echo "  ⚠  не импортируется gi / Gtk 3 / GtkLayerShell"
        echo "     sudo apt install python3-gi gir1.2-gtk-3.0 gir1.2-gtklayershell-0.1"
    fi
}

install_satty
register_browser_here
check_overview_packages
install_ytm
check_media_packages
