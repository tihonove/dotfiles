#!/usr/bin/env bash
# Открыть каталог или файл в diode ГЛАВНОЙ панелью окна tmux, где сидит человек.
#
#   diode-here [каталог|файл]        # по умолчанию — текущий каталог
#   diode-here -t %12 [каталог|файл] # явная панель (любой target tmux: %12, 2:4)
#
# Файл открывается сам, рабочим каталогом панели становится его каталог.
#
# Сценарий: в окне одна панель с Клодом, он что-то наделал, хочется посмотреть.
# Скрипт режет окно, ставит diode слева на 66% (main-vertical, ширина — из
# main-pane-width в tmux.conf), а Клод уезжает в колонку справа. Закрыл diode —
# панель схлопнулась, Клод снова один во всё окно.
#
# Зачем отдельный скрипт, а не `split-window diode`. Главная панель в
# main-vertical — та, что первая в списке панелей окна. `split-window -b`
# ставит новую ПЕРЕД текущей, но если текущая сама не первая (в окне уже есть
# ещё панели), новая первой не станет. Поэтому после разбивки — swap-pane с
# тем, что в левом верхнем углу; из одной панели это холостой ход, но условие
# общее.
#
# Целевое окно — то, где панель ВЫЗЫВАЮЩЕГО, а не активное окно клиента: пока
# агент работал, человек мог уйти в другое окно, и резать надо не его. Активное
# окно клиента скрипт не трогает, фокус меняет только внутри целевого.
#
# Как ищется панель вызывающего:
#   1) -t — что сказали, то и берём;
#   2) $TMUX_PANE — обычный запуск из панели (агент в интерактивной сессии тоже
#      её наследует);
#   3) tmux-host-env — сессия из `claude agents` сидит в pty демона, а не в
#      панели: скрипт найдёт tmux-сессию, где человек последним печатал, и
#      `claude agents` в ней (или активную панель), — туда diode и встанет.
# Панель не нашлась — живой терминал получит просто diode, агент откажет: TUI
# без терминала повиснет намертво.
#
# Повторный вызов на тот же каталог не плодит второй diode: панель помечена
# @diode_dir, найдётся — снова станет главной и получит фокус. Другой каталог
# — другой diode, это честно.

set -euo pipefail

die() { echo "diode-here: $*" >&2; exit 1; }

pane=
while [[ ${1:-} == -* ]]; do
    case $1 in
        -t|--pane) pane=${2:-}; [[ -n $pane ]] || die "-t без панели"; shift 2 ;;
        --) shift; break ;;
        *) die "неизвестный ключ $1" ;;
    esac
done

dir=$(realpath -- "${1:-.}")
[[ -e $dir ]] || die "нет такого файла или каталога $dir"
cwd=$dir
[[ -d $cwd ]] || cwd=$(dirname -- "$dir")

if [[ -z $pane && -n ${TMUX:-} && -n ${TMUX_PANE:-} ]]; then
    pane=$TMUX_PANE
fi

if [[ -z $pane ]]; then
    # DIODE_HERE_REEXEC — от бесконечного цикла, если панель найдена, а
    # окружение почему-то не доехало.
    if [[ -z ${DIODE_HERE_REEXEC:-} ]] && tmux-host-env >/dev/null 2>&1; then
        DIODE_HERE_REEXEC=1 exec tmux-host-env "$0" "$dir"
    fi
    # Живой терминал без tmux — просто редактор. Не терминал (агент, пайп) —
    # TUI повиснет намертво, лучше сразу отказ.
    [[ -t 0 && -t 1 ]] || die "не нашёл панель tmux — укажи её: diode-here -t %<id> $dir"
    exec diode "$dir"
fi

# Битый target для display-message — не ошибка: печатает пустое и выходит с нулём,
# а дальше list-panes без -t порезал бы чужое активное окно. Отсюда проверка.
caller=$(tmux display-message -t "$pane" -p '#{pane_id}')
[[ $caller == %* ]] || die "нет панели $pane"
win=$(tmux display-message -t "$caller" -p '#{session_id}:#{window_id}')

pane=$(tmux list-panes -t "$win" -F '#{pane_id} #{@diode_dir}' \
       | awk -v d="$dir" '$2 == d { print $1; exit }')

if [[ -z $pane ]]; then
    pane=$(tmux split-window -b -h -P -F '#{pane_id}' -t "$caller" -c "$cwd" -- diode "$dir")
    tmux set-option -p -t "$pane" @diode_dir "$dir"
fi

top_left=$(tmux display-message -t "$win.{top-left}" -p '#{pane_id}')
[[ $pane == "$top_left" ]] || tmux swap-pane -s "$pane" -t "$top_left"
tmux select-layout -t "$win" main-vertical
tmux select-pane -t "$pane"

echo "$pane"
