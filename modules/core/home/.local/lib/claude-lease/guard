#!/usr/bin/env bash
# PreToolUse-хук: не пускать тяжёлый прогон в обход лизы.
#
# Хук — машинная страховка на случай «сеанс забыл про скилл»: слот сам себя не
# возьмёт, а параллельный Stryker роняет тачку. Всё, что может сломаться
# (нет node, нет ёмкостей, нет манифеста, чужой проект), трактуем как
# «лиза не нужна» и молча пропускаем: страховка не должна становиться стеной.
set -uo pipefail

# PATH тут доверять нельзя: ~/.local/bin добавляет rc.sh, и только для
# интерактивного шелла, а хук зовёт сам claude. Поэтому путь к лизе — явный.
LEASE="${CLAUDE_LEASE_BIN:-$HOME/.local/bin/claude-lease}"
CAPACITY_FILE="${CLAUDE_LEASE_HOME:-$HOME/.claude/lease}/capacity"

command -v node >/dev/null 2>&1 || exit 0
[[ -r "$CAPACITY_FILE" && -x "$LEASE" ]] || exit 0

cmd="$(node -e '
let s = "";
process.stdin.on("data", (d) => (s += d)).on("end", () => {
    try {
        const j = JSON.parse(s);
        if (j.tool_name !== "Bash") return;
        process.stdout.write(String(j.tool_input?.command ?? ""));
    } catch {}
});
' 2>/dev/null)" || exit 0

[[ -n "$cmd" ]] || exit 0
# Уже под лизой (или это сама лиза) — пропускаем.
[[ "$cmd" == *claude-lease* ]] && exit 0

# Дешёвый отсев, чтобы не платить запуском node на каждом `git status`: под лизу
# может попасть только запуск сборки/тестов. Это не политика проекта (её знает
# манифест), а грубый фильтр «похоже на прогон».
[[ "$cmd" =~ (npm|npx|pnpm|yarn|bun|node|vitest|jest|stryker|make|cargo|gradle|mvn) ]] || exit 0

out="$("$LEASE" match "$cmd" 2>/dev/null)" || exit 0
[[ -n "$out" ]] || exit 0
res="${out%%$'\t'*}"
why="${out#*$'\t'}"

n="$("$LEASE" capacity "$res" 2>/dev/null)" || exit 0
[[ -n "$n" && "$n" != "0" ]] || exit 0

cat >&2 <<MSG
Прогон в обход лизы запрещён: команда берёт ресурс «$res», слотов на машине — $n.
Почему: $why

Запусти ровно то же самое через лизу:
  claude-lease run -- $cmd

И просто дай ей висеть. Лиза стоит в очереди столько, сколько нужно, и не таймаутится:
впереди может идти сорокаминутный мутационный гейт, это нормально. Bash на 120-й
секунде сам уводит команду в фон и разбудит тебя по завершении — ни ждать слот, ни
гонять долгий прогон в foreground не страшно, ничего сторожить не надо.

Не ставь -w: с ним лиза перестаёт ждать и выходит кодом 75, а это «занято», не
падение прогона (тесты при 75 даже не запускались — чинить нечего, надо повторить).
Кто держит ресурс и сколько уже: claude-lease status. Держателя убили, а прогон
остался жив: claude-lease reap.
MSG
exit 2
