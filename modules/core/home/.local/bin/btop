#!/usr/bin/env bash
# Обёртка над btop: перед запуском обновляет файл темы, потом отдаёт управление
# настоящему бинарю.
#
# Зачем вообще обёртка. Тему btop читает только при старте и палитру держит
# захардкоженным hex — сослаться на цвета терминала формат .theme не умеет (пустая
# строка допустима лишь у main_bg и mid-точек градиентов). Значит палитру надо
# испечь заранее, и кто-то должен решить, какую именно.
#
# На рабочей станции это решает `theme-toggle refresh` при каждом переключении.
# Но на удалённой машине и в контейнере refresh звать некому: там тему один раз
# при установке пёк modules/core/update — и файл оставался таким навсегда, каким
# бы ни была тема сессии, из которой ты туда пришёл. Отсюда и белый btop посреди
# тёмной сессии: theme-colors без gsettings отвечал «светлая».
#
# Теперь theme-colors умеет спрашивать сам терминал (OSC 11), а спрашивать его
# нужно в момент запуска — тема сессии между установкой и запуском меняется
# сколько угодно раз. Ровно это здесь и делается.
#
# Шадовинг бинаря по имени — осознанный размен. Альтернатива (свой алиас или имя
# btop-themed) требует помнить, чем запускать, и не работает из tmux-биндингов и
# чужих скриптов; здесь же btop остаётся btop, а вся разница — один запуск
# генератора палитры перед exec. На машине, где отвечает gsettings, это лишние
# ~10 мс; там, где отвечает терминал, — столько же.

set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")

# Настоящий btop — первый в PATH, который не мы сами. Сравниваем по realpath, а
# не по пути: наш скрипт лежит в ~/.local/bin симлинком в репу, и путь из PATH с
# путём файла не совпадает.
real=
while IFS= read -r cand; do
    [[ -n "$cand" && "$(readlink -f "$cand" 2>/dev/null)" != "$self" ]] || continue
    real=$cand
    break
done < <(type -aP btop 2>/dev/null || true)

if [[ -z "$real" ]]; then
    echo "${0##*/}: настоящий btop не найден в PATH (обёртка — это $self)" >&2
    exit 127
fi

# Тему обновляем только когда btop действительно рисуют в терминал. Без этой
# проверки `btop --version` из скрипта или по `ssh host btop ...` без tty
# перезаписал бы файл догадкой (спросить-то некого), затерев правильную тему,
# которую до этого испёк установщик, сидя в настоящем терминале.
if [[ -t 1 ]]; then
    colors="$HOME/.local/bin/theme-colors"
    dest="$HOME/.config/btop/themes/catppuccin.theme"

    if [[ -x "$colors" ]]; then
        # Через временный файл рядом: генератор пишет в stdout, и прямое
        # перенаправление в $dest обнулило бы тему при любой его ошибке. Тут
        # неудача просто оставляет прежний файл — btop поднимется в старой
        # палитре, что заметно меньшая беда, чем свалиться в тему Default.
        #
        # Молча: сообщать некуда — btop первым же кадром затирает экран.
        if mkdir -p "$(dirname "$dest")" 2>/dev/null &&
           tmp=$(mktemp "$dest.XXXXXX" 2>/dev/null); then
            if "$colors" btop >"$tmp" 2>/dev/null; then
                mv -f "$tmp" "$dest"
            else
                rm -f "$tmp"
            fi
        fi
    fi
fi

exec "$real" "$@"
