#!/usr/bin/env bash
# Палитра сессии. Две оси, независимые друг от друга:
#
#   палитра — catppuccin (Mocha/Latte) или nord; выбирается на машину файлом
#             ~/.config/dotfiles/palette, пишет его `theme-toggle palette`;
#   режим   — тёмный/светлый; gsettings, переключает `theme-toggle`.
#
# Единственное место, где лежат сами цвета. Скрипт смотрит, какая палитра и
# какой режим стоят сейчас, и печатает готовый кусок конфига для запрошенного
# потребителя:
#
#   theme-colors kitty   — строки kitty.conf; kitty зовёт скрипт сам, через
#                          `geninclude theme.sh` (обёртка нужна, потому что
#                          geninclude вызывает программу без аргументов)
#   theme-colors sway    — команды client.*/output; theme-toggle refresh скармливает
#                          их swaymsg построчно, живому sway, без reload
#   theme-colors css     — блок @define-color для waybar и wofi; у GTK-CSS
#                          генератора нет, поэтому результат ложится на диск
#                          файлом (см. theme-toggle refresh)
#   theme-colors btop    — файл .theme для btop; тоже на диск, по фиксированному
#                          пути ~/.config/btop/themes/catppuccin.theme, на который
#                          ссылается btop.conf (см. theme-toggle refresh)
#   theme-colors tmux    — @thm_* для плагина catppuccin; на диск, в
#                          ~/.config/tmux/theme.conf, tmux.conf читает его ДО
#                          плагина (см. theme-toggle refresh и modules/core/update)
#   theme-colors swaylock — конфиг swaylock целиком; на диск (theme-toggle refresh)
#   theme-colors vscode  — имя темы VS Code; theme-toggle palette вписывает его
#                          в settings.json
#   theme-colors slack   — строка кастомной темы Slack; вставляется руками
#   theme-colors palette — имя текущей палитры (для theme-toggle)
#
# Вторым и третьим аргументами можно задать режим и палитру явно — удобно, чтобы
# сравнить два вывода, не переключая сессию:
# `diff <(theme-colors css dark catppuccin) <(theme-colors css dark nord)`.
#
# Значения Latte сняты с upstream: kitten themes --dump-theme Catppuccin-Latte.
# Значения Nord — с nordtheme.com; раскладка по ANSI-16 сверена с
# kitten themes --dump-theme Nord.

set -euo pipefail

# ── Палитры ───────────────────────────────────────────────────────────────────
# Роли одинаковые в обеих, отличаются только значения. Всё, что ниже, обращается
# к цветам ТОЛЬКО по имени роли — так светлая тема получается переносом один в
# один, без ручного подбора.
#
# Порядок ролей — от акцентов к фонам, как в оригинальной палитре Catppuccin:
# base — фон, mantle/crust — на тон глубже (в Latte, наоборот, светлее),
# surface* — плашки, overlay* — приглушённый текст, subtext*/text — текст.

declare -A MOCHA=(
    [rosewater]=#f5e0dc [flamingo]=#f2cdcd [pink]=#f5c2e7  [mauve]=#cba6f7
    [red]=#f38ba8       [maroon]=#eba0ac   [peach]=#fab387 [yellow]=#f9e2af
    [green]=#a6e3a1     [teal]=#94e2d5     [sky]=#89dceb   [sapphire]=#74c7ec
    [blue]=#89b4fa      [lavender]=#b4befe
    [text]=#cdd6f4      [subtext1]=#bac2de [subtext0]=#a6adc8
    [overlay2]=#9399b2  [overlay1]=#7f849c [overlay0]=#6c7086
    [surface2]=#585b70  [surface1]=#45475a [surface0]=#313244
    [base]=#1e1e2e      [mantle]=#181825   [crust]=#11111b
)

declare -A LATTE=(
    [rosewater]=#dc8a78 [flamingo]=#dd7878 [pink]=#ea76cb  [mauve]=#8839ef
    [red]=#d20f39       [maroon]=#e64553   [peach]=#fe640b [yellow]=#df8e1d
    [green]=#40a02b     [teal]=#179299     [sky]=#04a5e5   [sapphire]=#209fb5
    [blue]=#1e66f5      [lavender]=#7287fd
    [text]=#4c4f69      [subtext1]=#5c5f77 [subtext0]=#6c6f85
    [overlay2]=#7c7f93  [overlay1]=#8c8fa1 [overlay0]=#9ca0b0
    [surface2]=#acb0be  [surface1]=#bcc0cc [surface0]=#ccd0da
    [base]=#eff1f5      [mantle]=#e6e9ef   [crust]=#dce0e8
)

# Nord в ролях Catppuccin. У Nord 16 цветов против 26 ролей, поэтому часть ролей
# схлопывается в одно значение — это нормально, потребители различают роли, а
# не значения. Где выбор был неочевиден:
#
#   base/mantle/crust — у Nord нет ничего темнее nord0, «на тон глубже» в нём
#                       идёт светлее (kitty в родной теме Nord красит полосу
#                       вкладок nord1). Поэтому mantle и crust = nord1, а не
#                       ещё один nord0. crust ещё и текст на акцентах — nord1
#                       там же, где у upstream-темы kitty;
#   text/subtext      — Snow Storm светлеет от nord4 к nord6, а не тускнеет,
#                       так что «приглушённый» текст выходит чуть ярче
#                       основного. Зато ANSI white/bright white совпадают с
#                       родной темой kitty (nord5/nord6), а fg — nord4, как везде;
#   overlay           — nord3 и его осветлённый вариант #616e88 (так Nord красит
#                       комментарии в редакторах; чистый nord3 для них тёмен);
#   blue/lavender     — nord9 рамка, nord8 индикатор: по гайду Nord nord8 — главный
#                       акцент интерфейса, nord9 — второстепенный;
#   pink/mauve        — оба nord15, другого пурпурного у Nord нет;
#   rosewater         — nord4: это курсор и выделение, у родной темы kitty курсор
#                       тоже nord4. Выделение получается инверсным, зато читается.
#
# Светлого Nord нет: авторы его не рисовали, а Aurora на светлом фоне не
# читается. Светлый режим при палитре nord — Latte (см. разбор аргументов).

declare -A NORD=(
    [rosewater]=#d8dee9 [flamingo]=#d08770 [pink]=#b48ead  [mauve]=#b48ead
    [red]=#bf616a       [maroon]=#bf616a   [peach]=#d08770 [yellow]=#ebcb8b
    [green]=#a3be8c     [teal]=#88c0d0     [sky]=#8fbcbb   [sapphire]=#5e81ac
    [blue]=#81a1c1      [lavender]=#88c0d0
    [text]=#d8dee9      [subtext1]=#e5e9f0 [subtext0]=#eceff4
    [overlay2]=#616e88  [overlay1]=#616e88 [overlay0]=#4c566a
    [surface2]=#4c566a  [surface1]=#434c5e [surface0]=#3b4252
    [base]=#2e3440      [mantle]=#3b4252   [crust]=#3b4252
)

# Порядок ролей для вывода css — руками, а не по ключам массива: у ассоциативных
# массивов bash порядок хэшевый, а файл читают глазами.
ROLES=(
    rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire
    blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0
    surface2 surface1 surface0 base mantle crust
)

# ── Текущая тема ──────────────────────────────────────────────────────────────
# Источник правды — тот же ключ, что ставит theme-toggle. Читаем его напрямую, а
# не через `theme-toggle get`: скрипты не должны звать друг друга по кругу.
#
# Спрашиваем по очереди, от самого осведомлённого источника к самому общему:
#
#   1. gsettings — сессия рабочей станции, единственное место, где тему реально
#      выбирал человек;
#   2. терминал — на удалённой машине и в контейнере gsettings ответить не может,
#      зато btop там рисуется в НАШЕМ терминале, а тот знает свой фон;
#   3. dark — если не ответил никто.
#
# Раньше шага 2 не было, и всё, кроме внятного prefer-dark, считалось светлой
# темой. На удалённой машине это давало белый btop посреди тёмной сессии: на
# tihonove-ivm gsettings установлен, но отвечает «No schemas installed», а
# modules/core/update печёт из этого ответа файл темы.

# Фон терминала через OSC 11. Запрос уходит и ответ читается на /dev/tty, а не на
# stdin/stdout: вывод у скрипта перенаправлен почти всегда (`theme-colors btop >
# themes/catppuccin.theme`), спрашивать надо именно терминал.
#
# Терминатор запроса — BEL, и ответ приходит с тем же терминатором, каким его
# спросили (так делают и xterm, и kitty). Если ответ всё же придёт с ST (ESC \),
# read дождётся таймаута, но прочитанное в переменной останется — регулярка
# разберёт и такой ответ.
#
# Чего это стоит: на время запроса терминал переводится в raw без эха, то есть
# нажатия, сделанные ровно в эти миллисекунды, съедаются вместе с ответом. Шаг
# доходит до сюда только там, где gsettings молчать не перестанет (удалённая
# машина, контейнер), и стоит либо один обмен пакетами, либо 0.3 с, если терминал
# запрос не понял. На рабочей станции этот код не выполняется вовсе.
terminal_bg_mode() {
    local reply saved r g b len max lum

    # Скобки не лишние: у голого `exec 3<>/dev/tty 2>/dev/null` редиректы
    # применяются по порядку, и ошибка открытия /dev/tty печатается ДО того, как
    # stderr уйдёт в /dev/null. Без терминала (update.sh по ssh без -t) это
    # давало «/dev/tty: No such device or address» на каждый вызов.
    { exec 3<>/dev/tty; } 2>/dev/null || return 1
    saved=$(stty -g <&3 2>/dev/null) || { exec 3>&- ; return 1; }

    # raw -echo: ответ терминала не должен ни отобразиться, ни ждать перевода
    # строки. Возвращаем режим сразу после чтения, до любого разбора.
    stty raw -echo <&3 2>/dev/null || { exec 3>&- ; return 1; }
    printf '\033]11;?\007' >&3
    IFS= read -r -d $'\a' -t 0.3 reply <&3 || true
    stty "$saved" <&3 2>/dev/null || true
    exec 3>&-

    # rgb:RRRR/GGGG/BBBB, но разрядность компонента по стандарту от 1 до 4 знаков,
    # поэтому нормируем по максимуму для своей длины, а не делим на 257.
    [[ "$reply" =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]] || return 1
    len=${#BASH_REMATCH[1]}
    max=$(( 16 ** len - 1 ))
    r=$(( 16#${BASH_REMATCH[1]} * 255 / max ))
    g=$(( 16#${BASH_REMATCH[2]} * 255 / max ))
    b=$(( 16#${BASH_REMATCH[3]} * 255 / max ))

    # Яркость с весами Rec. 709, целочисленно. Гамму не разворачиваем: тут нужен
    # не точный расчёт, а сторона от середины, а запас огромный — Mocha даёт 31,
    # Latte 240 из 255.
    lum=$(( (2126 * r + 7152 * g + 722 * b) / 10000 ))
    (( lum < 128 )) && echo dark || echo light
}

current_mode() {
    local gs from_tty

    # gsettings может быть установлен и при этом не иметь схем — тогда он пишет
    # в stderr и выходит с ошибкой. Поэтому смотрим на код возврата, а не только
    # на текст: непустой мусор в выводе не должен сойти за ответ.
    if gs=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null); then
        case "$gs" in
            *prefer-dark*)  echo dark;  return ;;
            # 'default' — это «предпочтения нет», и весь остальной стек трактует
            # его как светлую тему; оставляем как было.
            *prefer-light*|*default*) echo light; return ;;
        esac
    fi

    if from_tty=$(terminal_bg_mode); then
        echo "$from_tty"
        return
    fi

    echo dark
}

# ── Текущая палитра ───────────────────────────────────────────────────────────
# Файл вне репы, по той же конвенции, что ~/.config/dotfiles/profile: какая
# палитра на этой машине — вещь машинная. Нет файла — catppuccin: так сессия
# выглядела до появления второй оси, и так она выглядит везде, где палитру не
# выбирали. Формат — одно слово, `#`-комментарии и пустые строки игнорируются.
#
# Через ssh палитра не передаётся: терминал по OSC 11 отдаёт только фон, по
# нему различима яркость, но не палитра. На удалённой машине палитру задают
# тем же файлом, руками.
PALETTE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/palette"

current_palette() {
    local p=
    [[ -r "$PALETTE_FILE" ]] &&
        p=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$PALETTE_FILE" | grep -m1 .) || true
    echo "${p:-catppuccin}"
}

# ── Вывод ─────────────────────────────────────────────────────────────────────

emit_kitty() {
    # Чёрный и белый из ANSI-16 — единственное место, где две темы расходятся не
    # значениями, а ролями. В тёмной «чёрный» берётся из плашек (surface), а
    # «белый» из текста (subtext); в светлой ровно наоборот, иначе ANSI-чёрный
    # оказался бы светлее фона. Так же это сделано в обеих upstream-темах.
    local ansi_black ansi_black_br ansi_white ansi_white_br
    if [[ "$mode" == dark ]]; then
        ansi_black=${C[surface1]}  ansi_black_br=${C[surface2]}
        ansi_white=${C[subtext1]}  ansi_white_br=${C[subtext0]}
    else
        ansi_black=${C[subtext1]}  ansi_black_br=${C[subtext0]}
        ansi_white=${C[surface2]}  ansi_white_br=${C[surface1]}
    fi

    cat <<EOF
# ${theme_name}. Сгенерировано theme-colors, руками не править.

foreground              ${C[text]}
background              ${C[base]}
selection_foreground    ${C[base]}
selection_background    ${C[rosewater]}

# Курсор
cursor                  ${C[rosewater]}
cursor_text_color       ${C[base]}

# Ссылка под мышью
url_color               ${C[rosewater]}

# Рамки окон kitty
active_border_color     ${C[lavender]}
inactive_border_color   ${C[overlay0]}
bell_border_color       ${C[yellow]}

# Полоса вкладок
active_tab_foreground   ${C[crust]}
active_tab_background   ${C[mauve]}
inactive_tab_foreground ${C[text]}
inactive_tab_background ${C[mantle]}
tab_bar_background      ${C[crust]}

# 16 цветов терминала
# black
color0  $ansi_black
color8  $ansi_black_br
# red
color1  ${C[red]}
color9  ${C[red]}
# green
color2  ${C[green]}
color10 ${C[green]}
# yellow
color3  ${C[yellow]}
color11 ${C[yellow]}
# blue
color4  ${C[blue]}
color12 ${C[blue]}
# magenta
color5  ${C[pink]}
color13 ${C[pink]}
# cyan
color6  ${C[teal]}
color14 ${C[teal]}
# white
color7  $ansi_white
color15 $ansi_white_br
EOF
}

emit_sway() {
    # Ровно те же строки, что лежат в конфиге sway дефолтом, но с текущей
    # палитрой. Комментариев и пустых строк тут нет намеренно: вывод построчно
    # уходит в swaymsg, а он ждёт команды, а не конфиг.
    #
    # Порядок полей client.*: border | background | text | indicator | child_border
    cat <<EOF
client.focused          ${C[blue]} ${C[base]} ${C[text]} ${C[lavender]} ${C[blue]}
client.focused_inactive ${C[surface1]} ${C[base]} ${C[subtext0]} ${C[surface1]} ${C[surface1]}
client.unfocused        ${C[surface0]} ${C[base]} ${C[overlay0]} ${C[surface0]} ${C[surface0]}
client.urgent           ${C[red]} ${C[base]} ${C[base]} ${C[red]} ${C[red]}
client.placeholder      ${C[base]} ${C[base]} ${C[text]} ${C[base]} ${C[base]}
client.background       ${C[base]}
output * bg ${C[base]} solid_color
EOF
}

emit_css() {
    # Один и тот же файл подходит и waybar, и wofi: оба на GTK-CSS и оба
    # обращаются к цветам через @имя-роли. Отдаём палитру целиком, а не только
    # используемые роли, — чтобы в style.css можно было взять любой цвет, не
    # трогая генератор.
    echo "/* ${theme_name}. Сгенерировано theme-colors, руками не править."
    echo "   Файл перезаписывает theme-toggle refresh; в git его нет. */"
    local role
    for role in "${ROLES[@]}"; do
        printf '@define-color %-10s %s;\n' "$role" "${C[$role]}"
    done
}

emit_btop() {
    # Формат темы btop — присваивания в ассоциативный массив theme[...].
    # Ключей около сорока, но половина из них — тройки start/mid/end: каждый
    # график и каждый индикатор в btop красится градиентом по высоте столбика.
    # Где градиент не нужен, mid и end оставляются пустыми — тогда цвет один.
    #
    # Роли расставлены так, чтобы цвет НЁС смысл, а не просто попадал в палитру:
    #
    #   рамки боксов  — четыре разных акцента, чтобы четыре области взгляд
    #                   различал по цвету, а не по чтению заголовков;
    #   температуры   — green→yellow→red, единственный градиент, который читается
    #   и загрузка cpu  однозначно: выше столбик — тревожнее цвет;
    #   память и сеть — градиенты в холодных тонах, тут высота столбика сама по
    #                   себе не «плохо», и красный сбивал бы с толку.
    cat <<EOF
# ${theme_name}. Сгенерировано theme-colors, руками не править.

# Фон и текст
theme[main_bg]="${C[base]}"
theme[main_fg]="${C[text]}"
theme[title]="${C[text]}"
theme[hi_fg]="${C[blue]}"
theme[inactive_fg]="${C[overlay0]}"

# Выделенная строка в списке процессов
theme[selected_bg]="${C[surface1]}"
theme[selected_fg]="${C[text]}"

# Подписи на графиках, подложка индикаторов, мелочь в боксе процессов
theme[graph_text]="${C[subtext0]}"
theme[meter_bg]="${C[surface1]}"
theme[proc_misc]="${C[rosewater]}"

# Рамки боксов и разделители
theme[cpu_box]="${C[mauve]}"
theme[mem_box]="${C[green]}"
theme[net_box]="${C[maroon]}"
theme[proc_box]="${C[blue]}"
theme[div_line]="${C[surface1]}"

# Температуры и загрузка cpu — «выше значит хуже»
theme[temp_start]="${C[green]}"
theme[temp_mid]="${C[yellow]}"
theme[temp_end]="${C[red]}"
theme[cpu_start]="${C[green]}"
theme[cpu_mid]="${C[yellow]}"
theme[cpu_end]="${C[red]}"

# Индикаторы памяти и дисков
theme[free_start]="${C[teal]}"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="${C[sapphire]}"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="${C[sky]}"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="${C[green]}"
theme[used_mid]="${C[yellow]}"
theme[used_end]="${C[red]}"

# Графики сети
theme[download_start]="${C[teal]}"
theme[download_mid]="${C[sky]}"
theme[download_end]="${C[blue]}"
theme[upload_start]="${C[lavender]}"
theme[upload_mid]="${C[mauve]}"
theme[upload_end]="${C[pink]}"
EOF
}

emit_tmux() {
    # Те же имена, что в themes/catppuccin_<flavor>_tmux.conf завендоренного
    # плагина. Плагин ставит свои через `set -o` — только если опция ещё не
    # задана, — поэтому tmux.conf читает этот файл ДО `run catppuccin.tmux`, и
    # плагин наши значения не трогает. Живому tmux после смены файла нужен
    # source-file всего tmux.conf (делает theme-toggle refresh): статус плагин
    # собирает форматами `#{@thm_*}`, но часть цветов запекает в опции при
    # загрузке, и без повторного прогона плагина они не обновятся.
    #
    # `set -g`, без -o: при повторном source значения должны перезаписываться.
    cat <<EOF
# ${theme_name}. Сгенерировано theme-colors, руками не править.
# Пишут theme-toggle refresh и modules/core/update; tmux.conf читает до плагина.
set -g @thm_bg "${C[base]}"
set -g @thm_fg "${C[text]}"

set -g @thm_rosewater "${C[rosewater]}"
set -g @thm_flamingo "${C[flamingo]}"
set -g @thm_pink "${C[pink]}"
set -g @thm_mauve "${C[mauve]}"
set -g @thm_red "${C[red]}"
set -g @thm_maroon "${C[maroon]}"
set -g @thm_peach "${C[peach]}"
set -g @thm_yellow "${C[yellow]}"
set -g @thm_green "${C[green]}"
set -g @thm_teal "${C[teal]}"
set -g @thm_sky "${C[sky]}"
set -g @thm_sapphire "${C[sapphire]}"
set -g @thm_blue "${C[blue]}"
set -g @thm_lavender "${C[lavender]}"

set -g @thm_subtext_1 "${C[subtext1]}"
set -g @thm_subtext_0 "${C[subtext0]}"
set -g @thm_overlay_2 "${C[overlay2]}"
set -g @thm_overlay_1 "${C[overlay1]}"
set -g @thm_overlay_0 "${C[overlay0]}"
set -g @thm_surface_2 "${C[surface2]}"
set -g @thm_surface_1 "${C[surface1]}"
set -g @thm_surface_0 "${C[surface0]}"
set -g @thm_mantle "${C[mantle]}"
set -g @thm_crust "${C[crust]}"
EOF
}

emit_swaylock() {
    # Конфиг целиком, а не только цвета: у swaylock нет include, а без файла он
    # поднимается в дефолтном белом. Опции вместе с их оговорками живут здесь.
    #
    # Цвета без «#»: swaylock читает голый RRGGBB[AA].
    local base=${C[base]#\#} text=${C[text]#\#}
    cat <<EOF
# ${theme_name}. Сгенерировано theme-colors, руками не править.
# Пишет theme-toggle refresh; в git файла нет.
#
# Замок всегда в тёмном режиме текущей палитры (theme-toggle зовёт генератор с
# явным dark): swaylock читает файл один раз при запуске, перекрасить живой
# нечем, а замок и должен быть тёмным.

ignore-empty-password
show-failed-attempts

color=$base
# indicator-idle-visible, а не голый \`indicator\`: короткого имени в swaylock 1.8
# нет, а getopt_long дотягивает префикс до нескольких длинных опций и падает с
# «option '--indicator' is ambiguous» — весь конфиг тогда не читается, и замок
# молча не поднимается (проверено, потеряли на этом полчаса).
indicator-idle-visible
indicator-radius=90
indicator-thickness=8
indicator-caps-lock

inside-color=$base
inside-clear-color=$base
inside-ver-color=$base
inside-wrong-color=$base

ring-color=${C[surface1]#\#}
ring-clear-color=${C[yellow]#\#}
ring-ver-color=${C[blue]#\#}
ring-wrong-color=${C[red]#\#}

key-hl-color=${C[green]#\#}
bs-hl-color=${C[red]#\#}
caps-lock-key-hl-color=${C[peach]#\#}
caps-lock-bs-hl-color=${C[red]#\#}

line-color=$base
line-clear-color=$base
line-ver-color=$base
line-wrong-color=$base
separator-color=$base

text-color=$text
text-clear-color=$text
text-ver-color=$text
text-wrong-color=$text
EOF
}

emit_vscode() {
    # Имя темы из расширения (label в его package.json). Совпадает с theme_name
    # не случайно: theme_name и подобран как «имя темы, как её зовут снаружи».
    # Разойдутся — разводить здесь, не трогая theme_name.
    echo "$theme_name"
}

emit_slack() {
    # Строка для Preferences → Themes → Custom theme, восемь цветов через запятую:
    # фон колонки, фон при наведении в меню, активный пункт, текст активного
    # пункта, пункт под курсором, текст, индикатор присутствия, бейдж упоминаний.
    # Slack это поле снаружи не задаёт никто — строка вставляется руками.
    printf '%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "${C[base]}" "${C[surface0]}" "${C[blue]}" "${C[crust]}" \
        "${C[surface1]}" "${C[text]}" "${C[green]}" "${C[red]}"
}

# ── Разбор аргументов ─────────────────────────────────────────────────────────

target="${1:-}"
mode="${2:-$(current_mode)}"
palette="${3:-$(current_palette)}"

# theme_name — имя темы, как её зовут снаружи (заголовки файлов, VS Code).
#
# nord:light → Latte: светлого Nord не существует, а без светлого режима
# переключатель ☾/☀ при палитре nord пришлось бы либо ломать, либо прятать.
# Latte — рабочая светлая тема, которая уже была; кто нарисует светлый Nord,
# заменит одну строку здесь.
case "$palette:$mode" in
    catppuccin:dark)  theme_name="Catppuccin Mocha"; declare -n SRC=MOCHA ;;
    catppuccin:light) theme_name="Catppuccin Latte"; declare -n SRC=LATTE ;;
    nord:dark)        theme_name="Nord";             declare -n SRC=NORD ;;
    nord:light)       theme_name="Catppuccin Latte"; declare -n SRC=LATTE ;;
    catppuccin:*|nord:*)
        echo "${0##*/}: неизвестный режим: $mode (dark|light)" >&2; exit 2 ;;
    *)
        echo "${0##*/}: неизвестная палитра: $palette (catppuccin|nord)" >&2; exit 2 ;;
esac

# Копия с разыменованного nameref: дальше по коду обращаемся к ней как к C.
declare -A C
for role in "${!SRC[@]}"; do C[$role]=${SRC[$role]}; done

case "$target" in
    kitty)    emit_kitty ;;
    sway)     emit_sway ;;
    css)      emit_css ;;
    btop)     emit_btop ;;
    tmux)     emit_tmux ;;
    swaylock) emit_swaylock ;;
    vscode)   emit_vscode ;;
    slack)    emit_slack ;;
    palette)  echo "$palette" ;;
    *)
        echo "usage: ${0##*/} kitty|sway|css|btop|tmux|swaylock|vscode|slack|palette [dark|light] [catppuccin|nord]" >&2
        exit 2
        ;;
esac
