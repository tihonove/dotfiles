#!/usr/bin/env bash
# Session palette. Two independent axes:
#
#   palette — catppuccin (Mocha/Latte) or nord; chosen per machine by the file
#             ~/.config/dotfiles/palette, written by `theme-toggle palette`;
#   mode    — dark/light; gsettings, switched by `theme-toggle`.
#
# The only place where the colors themselves live. The script looks at which
# palette and mode are active right now and prints a ready-made config snippet
# for the requested consumer:
#
#   theme-colors kitty   — kitty.conf lines; kitty calls the script itself, via
#                          `geninclude theme.sh` (the wrapper is needed because
#                          geninclude runs the program without arguments)
#   theme-colors sway    — client.*/output commands; theme-toggle refresh feeds
#                          them to swaymsg line by line, into the live sway, no reload
#   theme-colors css     — a @define-color block for waybar and wofi; GTK-CSS has
#                          no generators, so the result lands on disk as a file
#                          (see theme-toggle refresh)
#   theme-colors btop    — a .theme file for btop; also on disk, at the fixed path
#                          ~/.config/btop/themes/catppuccin.theme referenced by
#                          btop.conf (see theme-toggle refresh)
#   theme-colors tmux    — @thm_* for the catppuccin plugin; on disk, in
#                          ~/.config/tmux/theme.conf, tmux.conf reads it BEFORE
#                          the plugin (see theme-toggle refresh and modules/core/update)
#   theme-colors swaylock — the whole swaylock config; on disk (theme-toggle refresh)
#   theme-colors telegram[-mute|-attention]
#                        — monochrome Telegram tray icon, SVG; on disk, into the
#                          icon theme ~/.local/share/icons (theme-toggle refresh)
#   theme-colors vscode  — VS Code theme name; theme-toggle palette writes it
#                          into settings.json
#   theme-colors slack   — Slack custom theme string; pasted by hand
#   theme-colors palette — current palette name (for theme-toggle)
#
# The second and third arguments set mode and palette explicitly — handy for
# comparing two outputs without switching the session:
# `diff <(theme-colors css dark catppuccin) <(theme-colors css dark nord)`.
#
# Latte values are taken from upstream: kitten themes --dump-theme Catppuccin-Latte.
# Nord values are from nordtheme.com; the ANSI-16 mapping is checked against
# kitten themes --dump-theme Nord.

set -euo pipefail

# ── Palettes ──────────────────────────────────────────────────────────────────
# The roles are the same in all of them, only the values differ. Everything below
# refers to colors ONLY by role name — that way the light theme is a one-to-one
# swap, with no hand-picking.
#
# Role order goes from accents to backgrounds, as in the original Catppuccin palette:
# base — background, mantle/crust — a shade deeper (in Latte, lighter instead),
# surface* — tiles, overlay* — muted text, subtext*/text — text.

declare -A MOCHA=(
    [rosewater]=#f5e0dc [flamingo]=#f2cdcd [pink]=#f5c2e7  [mauve]=#cba6f7
    [red]=#f38ba8       [maroon]=#eba0ac   [peach]=#fab387 [yellow]=#f9e2af
    [green]=#a6e3a1     [teal]=#94e2d5     [sky]=#89dceb   [sapphire]=#74c7ec
    [blue]=#89b4fa      [lavender]=#b4befe
    [text]=#cdd6f4      [subtext1]=#bac2de [subtext0]=#a6adc8
    [overlay2]=#9399b2  [overlay1]=#7f849c [overlay0]=#6c7086
    [surface2]=#585b70  [surface1]=#45475a [surface0]=#313244
    [base]=#1e1e2e      [mantle]=#181825   [crust]=#11111b
)

declare -A LATTE=(
    [rosewater]=#dc8a78 [flamingo]=#dd7878 [pink]=#ea76cb  [mauve]=#8839ef
    [red]=#d20f39       [maroon]=#e64553   [peach]=#fe640b [yellow]=#df8e1d
    [green]=#40a02b     [teal]=#179299     [sky]=#04a5e5   [sapphire]=#209fb5
    [blue]=#1e66f5      [lavender]=#7287fd
    [text]=#4c4f69      [subtext1]=#5c5f77 [subtext0]=#6c6f85
    [overlay2]=#7c7f93  [overlay1]=#8c8fa1 [overlay0]=#9ca0b0
    [surface2]=#acb0be  [surface1]=#bcc0cc [surface0]=#ccd0da
    [base]=#eff1f5      [mantle]=#e6e9ef   [crust]=#dce0e8
)

# Nord in Catppuccin roles. Nord has 16 colors against 26 roles, so some roles
# collapse into one value — that's fine, consumers distinguish roles, not
# values. Where the choice wasn't obvious:
#
#   base/mantle/crust — Nord has nothing darker than nord0, "a shade deeper" in it
#                       goes lighter (kitty's native Nord theme paints the tab
#                       bar nord1). So mantle and crust = nord1, not yet another
#                       nord0. crust is also the text on accents — nord1, same
#                       as the upstream kitty theme;
#   text/subtext      — Snow Storm gets lighter from nord4 to nord6 instead of
#                       dimmer, so "muted" text comes out slightly brighter than
#                       the main one. In exchange ANSI white/bright white match
#                       kitty's native theme (nord5/nord6), and fg is nord4, as everywhere;
#   overlay           — nord3 and its lightened variant #616e88 (that's how Nord
#                       colors comments in editors; plain nord3 is too dark for them);
#   blue/lavender     — nord9 border, nord8 indicator: per the Nord guide nord8 is the
#                       primary UI accent, nord9 the secondary one;
#   pink/mauve        — both nord15, Nord has no other purple;
#   rosewater         — nord4: it's the cursor and selection, kitty's native theme
#                       also has a nord4 cursor. Selection ends up inverted, but readable.
#
# There's no light Nord: its authors never drew one, and Aurora is unreadable on
# a light background. Light mode with the nord palette is Latte (see argument parsing).

declare -A NORD=(
    [rosewater]=#d8dee9 [flamingo]=#d08770 [pink]=#b48ead  [mauve]=#b48ead
    [red]=#bf616a       [maroon]=#bf616a   [peach]=#d08770 [yellow]=#ebcb8b
    [green]=#a3be8c     [teal]=#88c0d0     [sky]=#8fbcbb   [sapphire]=#5e81ac
    [blue]=#81a1c1      [lavender]=#88c0d0
    [text]=#d8dee9      [subtext1]=#e5e9f0 [subtext0]=#eceff4
    [overlay2]=#616e88  [overlay1]=#616e88 [overlay0]=#4c566a
    [surface2]=#4c566a  [surface1]=#434c5e [surface0]=#3b4252
    [base]=#2e3440      [mantle]=#3b4252   [crust]=#3b4252
)

# Role order for css output — by hand, not by array keys: bash associative
# arrays are ordered by hash, and the file is read by humans.
ROLES=(
    rosewater flamingo pink mauve red maroon peach yellow green teal sky sapphire
    blue lavender text subtext1 subtext0 overlay2 overlay1 overlay0
    surface2 surface1 surface0 base mantle crust
)

# ── Current theme ─────────────────────────────────────────────────────────────
# The source of truth is the same key theme-toggle sets. Read it directly, not
# via `theme-toggle get`: scripts shouldn't call each other in circles.
#
# Ask in turn, from the best-informed source to the most generic:
#
#   1. gsettings — the workstation session, the only place where a human actually
#      chose the theme;
#   2. terminal — on a remote machine or in a container gsettings can't answer,
#      but btop is drawn there in OUR terminal, and it knows its background;
#   3. dark — if nobody answered.
#
# Step 2 used to be missing, and anything other than a clear prefer-dark counted
# as the light theme. On a remote machine that gave a white btop in the middle of
# a dark session: on tihonove-ivm gsettings is installed but answers "No schemas
# installed", and modules/core/update bakes the theme file from that answer.

# Terminal background via OSC 11. The query is sent and the reply read on
# /dev/tty, not stdin/stdout: the script's output is almost always redirected
# (`theme-colors btop > themes/catppuccin.theme`), it's the terminal we must ask.
#
# The query terminator is BEL, and the reply comes with the same terminator it
# was asked with (both xterm and kitty do this). If the reply does come with ST
# (ESC \), read waits for the timeout, but what was read stays in the variable —
# the regex parses that reply too.
#
# What it costs: for the duration of the query the terminal is put into raw with
# no echo, so keystrokes made in exactly those milliseconds are eaten along with
# the reply. This step is only reached where gsettings won't stop being silent
# (remote machine, container), and costs either one round trip or 0.3 s if the
# terminal didn't understand the query. On the workstation this code never runs.
terminal_bg_mode() {
    local reply saved r g b len max lum

    # The braces aren't redundant: with a bare `exec 3<>/dev/tty 2>/dev/null` the
    # redirections apply in order, and the error opening /dev/tty is printed
    # BEFORE stderr goes to /dev/null. Without a terminal (update.sh over ssh
    # without -t) that gave "/dev/tty: No such device or address" on every call.
    { exec 3<>/dev/tty; } 2>/dev/null || return 1
    saved=$(stty -g <&3 2>/dev/null) || { exec 3>&- ; return 1; }

    # raw -echo: the terminal's reply must neither be displayed nor wait for a
    # newline. Restore the mode right after reading, before any parsing.
    stty raw -echo <&3 2>/dev/null || { exec 3>&- ; return 1; }
    printf '\033]11;?\007' >&3
    IFS= read -r -d $'\a' -t 0.3 reply <&3 || true
    stty "$saved" <&3 2>/dev/null || true
    exec 3>&-

    # rgb:RRRR/GGGG/BBBB, but per the spec a component has 1 to 4 digits, so
    # normalize by the maximum for its length instead of dividing by 257.
    [[ "$reply" =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]] || return 1
    len=${#BASH_REMATCH[1]}
    max=$(( 16 ** len - 1 ))
    r=$(( 16#${BASH_REMATCH[1]} * 255 / max ))
    g=$(( 16#${BASH_REMATCH[2]} * 255 / max ))
    b=$(( 16#${BASH_REMATCH[3]} * 255 / max ))

    # Luminance with Rec. 709 weights, in integers. No gamma decoding: what's
    # needed isn't a precise value but which side of the middle, and the margin is
    # huge — Mocha gives 31, Latte 240 out of 255.
    lum=$(( (2126 * r + 7152 * g + 722 * b) / 10000 ))
    (( lum < 128 )) && echo dark || echo light
}

current_mode() {
    local gs from_tty

    # gsettings can be installed and still have no schemas — then it writes to
    # stderr and exits with an error. So look at the exit code, not just the
    # text: non-empty garbage in the output must not pass for an answer.
    if gs=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null); then
        case "$gs" in
            *prefer-dark*)  echo dark;  return ;;
            # 'default' means "no preference", and the rest of the stack treats
            # it as the light theme; keep it that way.
            *prefer-light*|*default*) echo light; return ;;
        esac
    fi

    if from_tty=$(terminal_bg_mode); then
        echo "$from_tty"
        return
    fi

    echo dark
}

# ── Current palette ───────────────────────────────────────────────────────────
# A file outside the repo, by the same convention as ~/.config/dotfiles/profile:
# which palette a machine uses is a per-machine thing. No file — catppuccin: that's
# how the session looked before the second axis appeared, and how it looks
# wherever no palette was chosen. Format: one word, `#` comments and blank lines
# are ignored.
#
# The palette isn't passed over ssh: via OSC 11 the terminal only reports its
# background, which tells brightness but not the palette. On a remote machine the
# palette is set by the same file, by hand.
PALETTE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/palette"

current_palette() {
    local p=
    [[ -r "$PALETTE_FILE" ]] &&
        p=$(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$PALETTE_FILE" | grep -m1 .) || true
    echo "${p:-catppuccin}"
}

# ── Output ────────────────────────────────────────────────────────────────────

emit_kitty() {
    # ANSI-16 black and white are the only place where the two themes differ not
    # in values but in roles. In dark, "black" comes from the tiles (surface) and
    # "white" from the text (subtext); in light it's exactly the reverse, otherwise
    # ANSI black would be lighter than the background. Both upstream themes do the same.
    local ansi_black ansi_black_br ansi_white ansi_white_br
    if [[ "$mode" == dark ]]; then
        ansi_black=${C[surface1]}  ansi_black_br=${C[surface2]}
        ansi_white=${C[subtext1]}  ansi_white_br=${C[subtext0]}
    else
        ansi_black=${C[subtext1]}  ansi_black_br=${C[subtext0]}
        ansi_white=${C[surface2]}  ansi_white_br=${C[surface1]}
    fi

    cat <<EOF
# ${theme_name}. Generated by theme-colors, do not edit by hand.

foreground              ${C[text]}
background              ${C[base]}
selection_foreground    ${C[base]}
selection_background    ${C[rosewater]}

# Cursor
cursor                  ${C[rosewater]}
cursor_text_color       ${C[base]}

# Link under the mouse
url_color               ${C[rosewater]}

# kitty window borders
active_border_color     ${C[lavender]}
inactive_border_color   ${C[overlay0]}
bell_border_color       ${C[yellow]}

# Tab bar
active_tab_foreground   ${C[crust]}
active_tab_background   ${C[mauve]}
inactive_tab_foreground ${C[text]}
inactive_tab_background ${C[mantle]}
tab_bar_background      ${C[crust]}

# 16 terminal colors
# black
color0  $ansi_black
color8  $ansi_black_br
# red
color1  ${C[red]}
color9  ${C[red]}
# green
color2  ${C[green]}
color10 ${C[green]}
# yellow
color3  ${C[yellow]}
color11 ${C[yellow]}
# blue
color4  ${C[blue]}
color12 ${C[blue]}
# magenta
color5  ${C[pink]}
color13 ${C[pink]}
# cyan
color6  ${C[teal]}
color14 ${C[teal]}
# white
color7  $ansi_white
color15 $ansi_white_br
EOF
}

emit_sway() {
    # Exactly the same lines as in the sway config's defaults, but with the
    # current palette. No comments or blank lines here on purpose: the output goes
    # line by line to swaymsg, which expects commands, not a config.
    #
    # client.* field order: border | background | text | indicator | child_border
    cat <<EOF
client.focused          ${C[blue]} ${C[base]} ${C[text]} ${C[lavender]} ${C[blue]}
client.focused_inactive ${C[surface1]} ${C[base]} ${C[subtext0]} ${C[surface1]} ${C[surface1]}
client.unfocused        ${C[surface0]} ${C[base]} ${C[overlay0]} ${C[surface0]} ${C[surface0]}
client.urgent           ${C[red]} ${C[base]} ${C[base]} ${C[red]} ${C[red]}
client.placeholder      ${C[base]} ${C[base]} ${C[text]} ${C[base]} ${C[base]}
client.background       ${C[base]}
output * bg ${C[base]} solid_color
EOF
}

emit_css() {
    # The same file works for both waybar and wofi: both use GTK-CSS and both
    # refer to colors via @role-name. Emit the whole palette, not just the roles
    # in use, so that style.css can take any color without touching the generator.
    echo "/* ${theme_name}. Generated by theme-colors, do not edit by hand."
    echo "   Overwritten by theme-toggle refresh; not in git. */"
    local role
    for role in "${ROLES[@]}"; do
        printf '@define-color %-10s %s;\n' "$role" "${C[$role]}"
    done
}

emit_btop() {
    # btop theme format — assignments into the associative array theme[...].
    # About forty keys, but half of them are start/mid/end triples: every graph
    # and every meter in btop is painted with a gradient along the bar height.
    # Where no gradient is needed, mid and end are left empty — one color then.
    #
    # Roles are assigned so that color CARRIES meaning, not just fits the palette:
    #
    #   box borders   — four different accents, so the eye tells the four areas
    #                   apart by color, not by reading the titles;
    #   temperatures  — green→yellow→red, the only gradient that reads
    #   and cpu load    unambiguously: higher bar — more alarming color;
    #   memory and    — gradients in cool tones, here a tall bar isn't "bad" by
    #   network         itself, and red would be misleading.
    cat <<EOF
# ${theme_name}. Generated by theme-colors, do not edit by hand.

# Background and text
theme[main_bg]="${C[base]}"
theme[main_fg]="${C[text]}"
theme[title]="${C[text]}"
theme[hi_fg]="${C[blue]}"
theme[inactive_fg]="${C[overlay0]}"

# Selected row in the process list
theme[selected_bg]="${C[surface1]}"
theme[selected_fg]="${C[text]}"

# Graph labels, meter background, misc in the process box
theme[graph_text]="${C[subtext0]}"
theme[meter_bg]="${C[surface1]}"
theme[proc_misc]="${C[rosewater]}"

# Box borders and dividers
theme[cpu_box]="${C[mauve]}"
theme[mem_box]="${C[green]}"
theme[net_box]="${C[maroon]}"
theme[proc_box]="${C[blue]}"
theme[div_line]="${C[surface1]}"

# Temperatures and cpu load — "higher means worse"
theme[temp_start]="${C[green]}"
theme[temp_mid]="${C[yellow]}"
theme[temp_end]="${C[red]}"
theme[cpu_start]="${C[green]}"
theme[cpu_mid]="${C[yellow]}"
theme[cpu_end]="${C[red]}"

# Memory and disk meters
theme[free_start]="${C[teal]}"
theme[free_mid]=""
theme[free_end]=""
theme[cached_start]="${C[sapphire]}"
theme[cached_mid]=""
theme[cached_end]=""
theme[available_start]="${C[sky]}"
theme[available_mid]=""
theme[available_end]=""
theme[used_start]="${C[green]}"
theme[used_mid]="${C[yellow]}"
theme[used_end]="${C[red]}"

# Network graphs
theme[download_start]="${C[teal]}"
theme[download_mid]="${C[sky]}"
theme[download_end]="${C[blue]}"
theme[upload_start]="${C[lavender]}"
theme[upload_mid]="${C[mauve]}"
theme[upload_end]="${C[pink]}"
EOF
}

emit_tmux() {
    # Same names as in themes/catppuccin_<flavor>_tmux.conf of the vendored
    # plugin. The plugin sets its own with `set -o` — only if the option isn't
    # set yet — so tmux.conf reads this file BEFORE `run catppuccin.tmux`, and
    # the plugin leaves our values alone. A live tmux needs a source-file of the
    # whole tmux.conf after the file changes (theme-toggle refresh does it): the
    # plugin builds the status with `#{@thm_*}` formats, but bakes some colors
    # into options at load time, and they won't update without rerunning the plugin.
    #
    # `set -g`, without -o: on a repeated source the values must be overwritten.
    cat <<EOF
# ${theme_name}. Generated by theme-colors, do not edit by hand.
# Written by theme-toggle refresh and modules/core/update; tmux.conf reads it before the plugin.
set -g @thm_bg "${C[base]}"
set -g @thm_fg "${C[text]}"

set -g @thm_rosewater "${C[rosewater]}"
set -g @thm_flamingo "${C[flamingo]}"
set -g @thm_pink "${C[pink]}"
set -g @thm_mauve "${C[mauve]}"
set -g @thm_red "${C[red]}"
set -g @thm_maroon "${C[maroon]}"
set -g @thm_peach "${C[peach]}"
set -g @thm_yellow "${C[yellow]}"
set -g @thm_green "${C[green]}"
set -g @thm_teal "${C[teal]}"
set -g @thm_sky "${C[sky]}"
set -g @thm_sapphire "${C[sapphire]}"
set -g @thm_blue "${C[blue]}"
set -g @thm_lavender "${C[lavender]}"

set -g @thm_subtext_1 "${C[subtext1]}"
set -g @thm_subtext_0 "${C[subtext0]}"
set -g @thm_overlay_2 "${C[overlay2]}"
set -g @thm_overlay_1 "${C[overlay1]}"
set -g @thm_overlay_0 "${C[overlay0]}"
set -g @thm_surface_2 "${C[surface2]}"
set -g @thm_surface_1 "${C[surface1]}"
set -g @thm_surface_0 "${C[surface0]}"
set -g @thm_mantle "${C[mantle]}"
set -g @thm_crust "${C[crust]}"
EOF
}

emit_swaylock() {
    # The whole config, not just colors: swaylock has no include, and without the
    # file it comes up in default white. The options live here with their caveats.
    #
    # Colors without "#": swaylock reads bare RRGGBB[AA].
    local base=${C[base]#\#} text=${C[text]#\#}
    cat <<EOF
# ${theme_name}. Generated by theme-colors, do not edit by hand.
# Written by theme-toggle refresh; the file is not in git.
#
# The lock is always in the dark mode of the current palette (theme-toggle calls
# the generator with an explicit dark): swaylock reads the file once at startup,
# there's no way to recolor a running one, and a lock screen should be dark anyway.

# No ignore-empty-password: an empty Enter means "check the finger" (pam_fprintd in
# /etc/pam.d/swaylock, see ~/.system-setup/fingerprint-swaylock.md).
show-failed-attempts

color=$base
# indicator-idle-visible, not a bare \`indicator\`: swaylock 1.8 has no such short
# name, and getopt_long expands the prefix to several long options and dies with
# "option '--indicator' is ambiguous" — the whole config is then not read, and the
# lock silently fails to come up (verified, lost half an hour on this).
indicator-idle-visible
indicator-radius=90
indicator-thickness=8
indicator-caps-lock

inside-color=$base
inside-clear-color=$base
inside-ver-color=$base
inside-wrong-color=$base

ring-color=${C[surface1]#\#}
ring-clear-color=${C[yellow]#\#}
ring-ver-color=${C[blue]#\#}
ring-wrong-color=${C[red]#\#}

key-hl-color=${C[green]#\#}
bs-hl-color=${C[red]#\#}
caps-lock-key-hl-color=${C[peach]#\#}
caps-lock-bs-hl-color=${C[red]#\#}

line-color=$base
line-clear-color=$base
line-ver-color=$base
line-wrong-color=$base
separator-color=$base

text-color=$text
text-clear-color=$text
text-ver-color=$text
text-wrong-color=$text
EOF
}

emit_telegram() {
    # Monochrome Telegram tray icon, one of three variants: "" (normal), mute,
    # attention. Telegram gives the tray not a picture but a name from the icon
    # theme (org.telegram.desktop[-mute|-attention]-symbolic; and the "Use
    # monochrome icon" checkbox in its settings only appears if such an icon
    # exists in the theme), and waybar draws it as is, without recoloring. So the
    # color is baked into the SVG.
    #
    # The drawing isn't ours: it's taken from the arm64 build extracted from the
    # snap (~/.system-setup/telegram-arm64.md), three colors in it are replaced —
    # the white plane, the grey mute badge, the red attention badge. No build — no
    # icon: an error, refresh skips this step.
    local variant="$1"
    local src="$HOME/.local/opt/telegram/app/usr/share/icons/hicolor/symbolic/apps/snap.telegram-desktop.${variant:+-$variant}-symbolic.svg"
    [[ -r "$src" ]] || { echo "${0##*/}: no source icon: $src" >&2; return 1; }
    sed -e "s/#FFFFFF/${C[text]}/I" \
        -e "s/#888888/${C[overlay1]}/I" \
        -e "s/#f23c34/${C[red]}/I" "$src"
}

emit_vscode() {
    # Theme name from the extension (label in its package.json). It matching
    # theme_name is no accident: theme_name was chosen as "the theme's name as the
    # outside world knows it". If they ever diverge — split them here, leaving theme_name alone.
    echo "$theme_name"
}

emit_slack() {
    # String for Preferences → Themes → Custom theme, eight comma-separated colors:
    # column background, menu hover background, active item, active item text,
    # item under cursor, text, presence indicator, mention badge.
    # Nothing sets this field in Slack from outside — the string is pasted by hand.
    printf '%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "${C[base]}" "${C[surface0]}" "${C[blue]}" "${C[crust]}" \
        "${C[surface1]}" "${C[text]}" "${C[green]}" "${C[red]}"
}

# ── Argument parsing ──────────────────────────────────────────────────────────

target="${1:-}"
mode="${2:-$(current_mode)}"
palette="${3:-$(current_palette)}"

# theme_name — the theme's name as the outside world knows it (file headers, VS Code).
#
# nord:light → Latte: there's no light Nord, and without a light mode the ☾/☀
# toggle would have to be either broken or hidden with the nord palette. Latte
# is a working light theme that already existed; whoever draws a light Nord
# replaces one line here.
case "$palette:$mode" in
    catppuccin:dark)  theme_name="Catppuccin Mocha"; declare -n SRC=MOCHA ;;
    catppuccin:light) theme_name="Catppuccin Latte"; declare -n SRC=LATTE ;;
    nord:dark)        theme_name="Nord";             declare -n SRC=NORD ;;
    nord:light)       theme_name="Catppuccin Latte"; declare -n SRC=LATTE ;;
    catppuccin:*|nord:*)
        echo "${0##*/}: unknown mode: $mode (dark|light)" >&2; exit 2 ;;
    *)
        echo "${0##*/}: unknown palette: $palette (catppuccin|nord)" >&2; exit 2 ;;
esac

# A copy of the dereferenced nameref: further down the code refers to it as C.
declare -A C
for role in "${!SRC[@]}"; do C[$role]=${SRC[$role]}; done

case "$target" in
    kitty)    emit_kitty ;;
    sway)     emit_sway ;;
    css)      emit_css ;;
    btop)     emit_btop ;;
    tmux)     emit_tmux ;;
    swaylock) emit_swaylock ;;
    telegram)           emit_telegram "" ;;
    telegram-mute)      emit_telegram mute ;;
    telegram-attention) emit_telegram attention ;;
    vscode)   emit_vscode ;;
    slack)    emit_slack ;;
    palette)  echo "$palette" ;;
    *)
        echo "usage: ${0##*/} kitty|sway|css|btop|tmux|swaylock|telegram[-mute|-attention]|vscode|slack|palette [dark|light] [catppuccin|nord]" >&2
        exit 2
        ;;
esac
