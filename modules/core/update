#!/bin/bash

# Внешние тулзы модуля core: starship, fzf, ble.sh.
#
# Бинарники в git не кладём. Прошлая версия dotfiles вендорила их в репу, и
# битый `.starship.arm` (32-битный ARM) на aarch64 не падал с ENOEXEC, а
# намертво вешал старт шелла внутри `$(starship init bash)`.
#
# Ни одного sudo: скрипт кладёт всё в ~/.local и работает в контейнере, где
# прав нет и apt звать некому.

set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../lib" && pwd)/tools.sh"

install_starship() {
    echo "starship..."

    # Системный (пакетный) starship не трогаем вовсе: подкладывать поверх свою
    # копию в ~/.local/bin — верный способ однажды запутаться, какая из двух в
    # PATH. Свой — сверяем по версии. Нет ни того ни другого — ставим бинарник,
    # и это путь контейнера: без sudo и свежее пакетного.
    #
    # Проверять просто `have starship` нельзя: PATH пополняется в rc.sh только
    # для интерактивного шелла, а этот скрипт зовут и из неинтерактивного ssh —
    # там ~/.local/bin не виден, и свой же бинарник качался бы заново.
    local path version tmp cur
    path="$(command -v starship || true)"
    if [[ -n "$path" && "$path" != "$BIN_DIR/starship" ]]; then
        echo "  ✅ системный: $("$path" --version | head -1) ($path)"
        return 0
    fi

    version=$(github_latest_version starship/starship)
    [[ -n "$version" ]] || { echo "❌ Не определил версию starship" >&2; return 1; }

    cur=$("$BIN_DIR/starship" --version 2>/dev/null | grep -oP '[0-9]+(\.[0-9]+)+' | head -1 || true)
    if [[ -n "$cur" && "$cur" == "$version" ]]; then
        echo "  ✅ уже актуален: starship $cur"
        return 0
    fi
    echo "  последний релиз: v$version"

    local target
    target="$(arch_for rust)"

    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" RETURN

    curl -fsSL -o "$tmp/starship.tar.gz" \
        "https://github.com/starship/starship/releases/download/v${version}/starship-${target}.tar.gz"
    tar -xzf "$tmp/starship.tar.gz" -C "$tmp"

    mkdir -p "$BIN_DIR"
    install -m 755 "$tmp/starship" "$BIN_DIR/starship"

    # Проверяем, что бинарник реально запускается на этой машине: неверная арка
    # диагностируется только в момент запуска.
    echo "  ✅ $("$BIN_DIR/starship" --version | head -1)"
}

install_blesh() {
    echo "ble.sh..."

    # Ветка nightly: последний стабильный релиз — апрель 2023, он старше самого
    # bash в системе. Апстрим ставить nightly и рекомендует.
    #
    # Ассет один на все архитектуры — это bash-скрипты, не бинарник.
    local installed="$HOME/.local/share/blesh/ble.sh" cur latest

    # У nightly нет версии в теге, зато рядом с ble-nightly.tar.xz апстрим
    # выкладывает датированную копию с коммитом в имени: ble-nightly-20260711
    # +d69e4d5.tar.xz. Установленный ble.sh знает свой коммит как
    # _ble_init_version=0.4.0-nightly+d69e4d5 — по нему и сверяем.
    if [[ -s "$installed" ]]; then
        cur=$(grep -m1 -oP '_ble_init_version=.*\+\K[0-9a-f]+' "$installed" || true)
        latest=$(curl -fsSL "https://api.github.com/repos/akinomyoga/ble.sh/releases/tags/nightly" \
            | grep -oP '"name":\s*"ble-nightly-[0-9]+\+\K[0-9a-f]+' | tail -1 || true)
        if [[ -n "$cur" && "$cur" == "$latest" ]]; then
            echo "  ✅ уже актуален: $(grep -m1 -oP '_ble_init_version=\K.*' "$installed")"
            return 0
        fi
    fi

    local tmp
    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" RETURN

    curl -fsSL -o "$tmp/ble.tar.xz" \
        "https://github.com/akinomyoga/ble.sh/releases/download/nightly/ble-nightly.tar.xz"
    tar -xJf "$tmp/ble.tar.xz" -C "$tmp"

    # --install раскладывает всё в ~/.local/share/blesh. Повторный запуск
    # перезаписывает — обновление делается тем же вызовом.
    bash "$tmp/ble-nightly/ble.sh" --install "$HOME/.local/share" >/dev/null

    local target="$HOME/.local/share/blesh/ble.sh"
    [[ -s "$target" ]] || { echo "❌ ble.sh не установился в $target" >&2; return 1; }

    echo "  ✅ ble.sh $(grep -m1 -oP '_ble_init_version=\K.*' "$target")"
}

install_fzf() {
    echo "fzf..."

    # Раньше fzf сюда не входил: считалось, что нужен именно пакет, потому что
    # он кладёт key-bindings.bash и completion.bash в /usr/share/doc/fzf/examples,
    # откуда их находит модуль интеграции ble.sh, а в тарболе с GitHub один
    # бинарник. Это перестало быть правдой: ble.sh умеет обходиться без файлов,
    # см. contrib/integration/fzf.common.bash —
    #
    #   ((version>=4800)) && base=__eval_fzf_bash__
    #
    # то есть для fzf >= 0.48 он берёт интеграцию из `fzf --bash`. Апстрим давно
    # 0.74, так что порог не актуален ни для одной живой версии.
    #
    # Из-за той догмы fzf не ставился нигде, кроме машин, где его поставили
    # руками пакетом, — в свежем контейнере его просто не было.
    #
    # Дальше та же логика, что у starship: системный не трогаем, свой сверяем
    # по версии.
    local path arch version tmp cur
    path="$(command -v fzf || true)"
    if [[ -n "$path" && "$path" != "$BIN_DIR/fzf" ]]; then
        echo "  ✅ системный: $("$path" --version) ($path)"
        return 0
    fi

    version=$(github_latest_version junegunn/fzf)
    [[ -n "$version" ]] || { echo "❌ Не определил версию fzf" >&2; return 1; }

    cur=$("$BIN_DIR/fzf" --version 2>/dev/null | grep -oP '[0-9]+(\.[0-9]+)+' | head -1 || true)
    if [[ -n "$cur" && "$cur" == "$version" ]]; then
        echo "  ✅ уже актуален: fzf $cur"
        return 0
    fi
    echo "  последний релиз: v$version"

    arch="$(arch_for plain)"

    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" RETURN

    curl -fsSL -o "$tmp/fzf.tar.gz" \
        "https://github.com/junegunn/fzf/releases/download/v${version}/fzf-${version}-linux_${arch}.tar.gz"
    tar -xzf "$tmp/fzf.tar.gz" -C "$tmp"

    mkdir -p "$BIN_DIR"
    install -m 755 "$tmp/fzf" "$BIN_DIR/fzf"

    echo "  ✅ $("$BIN_DIR/fzf" --version)"
}

install_kitten() {
    echo "kitten..."

    # Нужен скрипту clip: он гоняет файлы между машинами через TTY-протокол
    # kitty (kitten transfer / kitten clipboard). Именно поэтому бинарник нужен
    # на КАЖДОЙ машине, куда ходишь, а не только на рабочей станции.
    #
    # Ассет — статический бинарник без распаковки, отдельный от самой kitty:
    # ставить терминал на сервер или в контейнер незачем, нужен только клиент.
    #
    # Системный не трогаем — та же логика, что у starship и fzf. Это важнее, чем
    # кажется: пакетный kitten идёт в комплекте с локальной kitty и одной с ней
    # версии, а свежий из релизов может уехать вперёд. Подкладывать его поверх
    # — верный способ получить скос версий протокола между терминалом и
    # клиентом на одной машине.
    local path version tmp cur arch
    path="$(command -v kitten || true)"
    if [[ -n "$path" && "$path" != "$BIN_DIR/kitten" ]]; then
        echo "  ✅ системный: $("$path" --version | head -1) ($path)"
        return 0
    fi

    version=$(github_latest_version kovidgoyal/kitty)
    [[ -n "$version" ]] || { echo "❌ Не определил версию kitty" >&2; return 1; }

    cur=$("$BIN_DIR/kitten" --version 2>/dev/null | grep -oP '[0-9]+(\.[0-9]+)+' | head -1 || true)
    if [[ -n "$cur" && "$cur" == "$version" ]]; then
        echo "  ✅ уже актуален: kitten $cur"
        return 0
    fi
    echo "  последний релиз: v$version"

    # Ассеты kitty называют арку как fzf: arm64 / amd64.
    arch="$(arch_for plain)"

    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" RETURN

    curl -fsSL -o "$tmp/kitten" \
        "https://github.com/kovidgoyal/kitty/releases/download/v${version}/kitten-linux-${arch}"

    mkdir -p "$BIN_DIR"
    install -m 755 "$tmp/kitten" "$BIN_DIR/kitten"

    echo "  ✅ $("$BIN_DIR/kitten" --version | head -1)"
}

ensure_clip_spool() {
    # Спул скрипта clip: сюда `kitten transfer` с удалённой машины складывает
    # файлы. Каталог обязан существовать ЗАРАНЕЕ — kitten transfer не создаёт
    # каталог назначения, а удалённая сторона создать его тут не может.
    #
    # Заводим на каждой машине, а не только на рабочей станции: «локальной»
    # оказывается та, за которой ты сейчас сидишь, и это может быть любая.
    mkdir -p "$HOME/.cache/clip/current"
}

ensure_btop_theme() {
    # Тема btop — производный файл, как colors.css у панели: btop.conf ссылается
    # на неё по фиксированному имени, а содержимое пишет генератор палитры.
    #
    # На машине со sway её обновляет `theme-toggle refresh` при каждом
    # переключении темы. Здесь — чтобы файл был и там, где refresh звать некому:
    # в контейнере и на сервере sway нет, а btop есть, и без этой строки он
    # молча свалился бы в тему Default, ссылку в конфиге просто не найдя.
    #
    # Тема берётся текущая. На машине без gsettings это всегда светлая (так
    # устроен theme-colors), и для контейнера это, честно говоря, не идеал —
    # но выбирать за пользователя тёмную здесь было бы враньём: раз спросить
    # некого, единственный внятный ответ даёт сам генератор палитры.
    local colors="$HOME/.local/bin/theme-colors"
    local dest="$HOME/.config/btop/themes/catppuccin.theme"

    # Симлинки install.sh раскладывает раньше, чем зовёт этот скрипт, так что
    # генератор на месте. Проверка — на случай запуска update руками из репы,
    # когда установки ещё не было.
    [[ -x "$colors" ]] || { echo "  ⚠️  btop: нет $colors, тема не сгенерирована"; return 0; }

    mkdir -p "$(dirname "$dest")"
    "$colors" btop >"$dest"
}

install_starship
install_fzf
install_blesh
install_kitten
ensure_clip_spool
ensure_btop_theme
