# ~/.ssh/config — управляемая часть.
#
# Хостов тут нет намеренно. Секретов в ssh-конфиге не бывает вовсе: ключи лежат
# отдельно, конфиг на них только ссылается. Но адреса машин, имена воркспейсов и
# пользователи, под которыми туда ходишь, — это инвентарь. Не секрет, а карта:
# секрет утекает один раз и его меняют, карта остаётся верной годами и читается
# как список целей. Репа публичная, поэтому карта живёт снаружи.
#
# Инвентарь — в ~/.ssh/config.d/*.conf: машинно-локально, в гит не уезжает.
# Тот же приём, что с ~/.bashrc (см. README): управляемое лежит в репе, локальное
# подключается сбоку. Заодно ловит корпоративные утилиты, если те однажды начнут
# дописывать свои Host-блоки — попадут в локальный слой, а не под гит.
#
# Include обязан стоять ПЕРВЫМ. В ssh_config выигрывает не последнее значение
# опции, а первое встреченное, так что подключённый локальный файл должен идти
# раньше всего, что могло бы его перебить.
#
# Отсутствующий каталог или маска без совпадений — не ошибка, ssh идёт дальше.
Include ~/.ssh/config.d/*.conf

# ── Воркспейсы devsy: как заводится хост ─────────────────────────────────────
#
# Сами блоки лежат в ~/.ssh/config.d/, здесь — только то, что стоит помнить.
#
# Заходим пользователем vscode (uid 1000), а не root: под root'ом devsy пускает
# по умолчанию, но рабочий пользователь в этих образах — vscode, и $HOME у него
# свой (/home/vscode).
#
# Сменить пользователя настройкой devsy нельзя — опции такой нет ни у провайдера,
# ни у контекста, а remoteUser в devcontainer.json потребовал бы пересборки
# контейнера. Поэтому пользователь зашит в ProxyCommand.
#
# Что это даёт помимо короткой команды: работают scp/rsync и VSCode Remote-SSH,
# которым нужен именно ssh-хост, а не `devsy ws ssh`.
#
# Путь к devsy пишется полным намеренно: ProxyCommand запускается и из GUI
# (VSCode), где ~/.local/bin в PATH может не оказаться. $HOME использовать
# можно — ProxyCommand выполняется через шелл, и переменная разворачивается.
# А вот ~ не разворачивается, и токена %d у ProxyCommand нет: он принимает
# только %%, %h, %n, %p и %r.
#
# Шаблон нового воркспейса — скопировать в ~/.ssh/config.d/local.conf, поменять
# <имя> и <id> (id смотреть в `devsy ws list`):
#
#   Host <имя>.devsy
#       User vscode
#       StrictHostKeyChecking no
#       UserKnownHostsFile /dev/null
#       LogLevel error
#       ProxyCommand "$HOME/.local/bin/devsy" ws ssh --stdio --context default --user vscode <id>
#
# Облачная машина, на которой живут сами контейнеры, заводится обычным блоком с
# HostName и User — тоже в локальном файле.
