#!/bin/bash

# Идемпотентная настройка devsy (https://devsy.sh) под облачную машину.
#
# Сам CLI ставит update-tools.sh. Тут только провайдер: существующий не
# пересоздаётся, а обновляется через `provider set`.
#
# Секретов здесь нет: ssh-провайдер берёт ключи из ~/.ssh / ssh-agent.
#
# ⚠ Контейнеры этот скрипт не трогает — он правит только локальный конфиг
#   devsy. Пересоздать воркспейс может `devsy ws up`, см. раздел ниже.

set -e

command -v devsy >/dev/null || { echo "devsy не установлен, запусти update-tools.sh" >&2; exit 1; }

echo "devsy $(devsy --version)"

# --- Провайдер ssh: облачная машина ---
#
# Адрес машины, пользователь и путь агента лежат ВНЕ репы. Секретов в них нет,
# но это инвентарь: не секрет, а карта, которая остаётся верной годами. Репа
# публичная — подробнее в шапке home/.ssh/config.
#
# Файл машинно-локальный, создаётся руками один раз.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/devsy-setup.conf"
if [[ ! -f "$CONF" ]]; then
    cat >&2 <<EOF
❌ Нет $CONF — в нём адрес облачной машины и путь агента.
   Создать так, значения свои:

     DEVSY_HOST=user@1.2.3.4
     DEVSY_PORT=22
     DEVSY_AGENT_PATH=/tmp/user/devsy/agent
EOF
    exit 1
fi
. "$CONF"

: "${DEVSY_HOST:?не задан в $CONF}"
: "${DEVSY_AGENT_PATH:?не задан в $CONF}"
: "${DEVSY_PORT:=22}"

ssh_options=(
    -o HOST="$DEVSY_HOST"
    -o PORT="$DEVSY_PORT"
    -o INACTIVITY_TIMEOUT=2h
    -o INJECT_DOCKER_CREDENTIALS=true
    -o INJECT_GIT_CREDENTIALS=true
    -o USE_BUILTIN_SSH=false
    -o DOCKER_PATH=docker
    -o AGENT_PATH="$DEVSY_AGENT_PATH"
)

if devsy provider list --result-format json -q | grep -q '"ssh"'; then
    echo "Провайдер ssh уже есть — обновляю опции..."
    devsy provider set ssh --single-machine "${ssh_options[@]}"
else
    echo "Добавляю провайдер ssh..."
    devsy provider add ssh --single-machine --use "${ssh_options[@]}"
fi

devsy provider use ssh

# IDE по умолчанию не навязываем: подключение — vscode/ssh по месту
devsy ide use none

# Дотфайлы в новых воркспейсах.
#
# Раньше тут стоял прочерк: по этому же адресу лежала СТАРАЯ репа, и каждый
# новый воркспейс тянул бы её. Теперь на main новая, так что включаем.
#
# DOTFILES_SCRIPT задаём явно, хотя install.sh devsy нашёл бы и сам по
# соглашению: пусть в конфиге будет видно, что именно запускается в контейнере.
# install.sh там раскладывает симлинки И ставит тулы включённых модулей
# (профиля в контейнере нет, значит core), то есть воркспейс поднимается
# сразу рабочим — без ручного второго шага.
devsy context set \
    -o DOTFILES_URL=https://github.com/tihonove/dotfiles \
    -o DOTFILES_SCRIPT=install.sh

echo "Готово. Проверка: devsy provider get ssh"

# ── Как подцепиться к УЖЕ СУЩЕСТВУЮЩИМ воркспейсам ────────────────────────────
#
# devsy держит метаданные воркспейса локально, в
# ~/.devsy/contexts/default/workspaces/<id>/workspace.json. На новой машине их
# нет, и `devsy ws up <repo>` не подключится к старому контейнеру, а поднимет
# НОВЫЙ: имя образа и тома содержат uid воркспейса, а он берётся из этого файла.
#
# Спасает то, что агент на хосте хранит свою копию. Восстановление:
#
#   ssh <host> 'cat ~/.devsy/contexts/default/workspaces/<id>/agent/workspace.json' \
#     | python3 -c 'import json,sys,os;
#         w=json.load(sys.stdin)["workspace"];
#         d=os.path.expanduser("~/.devsy/contexts/default/workspaces/"+w["id"]);
#         os.makedirs(d, exist_ok=True);
#         json.dump(w, open(d+"/workspace.json","w"), indent=2)'
#
# После этого `devsy ws list` покажет воркспейс, `devsy ws status <id>` вернёт
# Running, а `devsy ws ssh <id>` зайдёт в существующий контейнер.
#
# Проверять до и после — `ssh <host> docker ps -a`: ID и uptime контейнеров
# меняться не должны.
