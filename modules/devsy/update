#!/bin/bash

# devsy CLI. Ставится отдельно от core: на машине, где не заходишь в удалённые
# воркспейсы, эти 122 МБ не нужны, а раньше они приезжали вместе со starship.

set -euo pipefail

. "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../lib" && pwd)/tools.sh"

echo "devsy..."

arch="$(arch_for go)"

# Бинарник 122 МБ, а install.sh теперь дёргает этот скрипт сам — качать его
# заново на каждый прогон нельзя. Сверяем `devsy --version` (отдаёт вида v1.14.1)
# с тегом последнего релиза.
latest=$(github_latest_version devsy-org/devsy || true)
current=$("$BIN_DIR/devsy" --version 2>/dev/null || true)
if [[ -n "$latest" && "${current#v}" == "$latest" ]]; then
    echo "  ✅ уже актуален: $current"
    exit 0
fi
[[ -z "$current" ]] || echo "  установлен $current, последний v$latest"

mkdir -p "$BIN_DIR"
curl -fsSL -o "$BIN_DIR/devsy" \
    "https://github.com/devsy-org/devsy/releases/latest/download/devsy-${arch}"
chmod +x "$BIN_DIR/devsy"

echo "  ✅ devsy $("$BIN_DIR/devsy" --version)"
echo "  дальше: modules/devsy/setup — настройка ssh-провайдера"
