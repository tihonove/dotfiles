# ── Облачная машина, где живут devsy-контейнеры ───────────────────────────────
Host devsy-host
    HostName 37.27.200.76
    User tihonove

# ── Воркспейсы devsy ──────────────────────────────────────────────────────────
#
# Заходим пользователем vscode (uid 1000), а не root: под root'ом devsy пускает
# по умолчанию, но рабочий пользователь в этих образах — vscode, и $HOME у него
# свой (/home/vscode).
#
# Сменить пользователя настройкой devsy нельзя — опции такой нет ни у провайдера,
# ни у контекста, а remoteUser в devcontainer.json потребовал бы пересборки
# контейнера. Поэтому пользователь зашит в ProxyCommand.
#
# Что это даёт помимо короткой команды: работают scp/rsync и VSCode Remote-SSH,
# которым нужен именно ssh-хост, а не `devsy ws ssh`.
#
# Путь к devsy абсолютный намеренно: ProxyCommand запускается и из GUI (VSCode),
# где ~/.local/bin в PATH может не оказаться.
#
# Новый воркспейс добавляется копией блока: поменять имя хоста и последний
# аргумент (id воркспейса, см. `devsy ws list`).

Host vexx.devsy
    User vscode
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel error
    ProxyCommand "/home/tihonove/.local/bin/devsy" ws ssh --stdio --context default --user vscode vexx

Host anki-cli.devsy
    User vscode
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel error
    ProxyCommand "/home/tihonove/.local/bin/devsy" ws ssh --stdio --context default --user vscode anki-cli
